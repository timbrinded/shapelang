{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "skills", "findings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "error"]
    },
    "summary": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "summary", "static_checks", "cases"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "shape-lang",
              "shape-contract-preflight",
              "shape-contract-guard",
              "shape-index",
              "shape-review"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail"]
          },
          "summary": {
            "type": "string"
          },
          "static_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "evidence"],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "mode-boundaries",
                    "draft-strict",
                    "current-cli",
                    "stable-refs",
                    "drift-review",
                    "baseline-separation",
                    "unknown-plan",
                    "decision-contract",
                    "impact-support-separation",
                    "semantic-normalization",
                    "source-boundary",
                    "structured-output",
                    "explicit-only",
                    "clean-baseline",
                    "no-invariant-quota",
                    "ast-navigation",
                    "code-first",
                    "all-incident-relations",
                    "false-positive-challenge",
                    "drift-separation"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": ["pass", "fail"]
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "outcome", "evidence", "commands"],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "lang-draft-strict",
                    "lang-final-forbid",
                    "preflight-guarded-unknown",
                    "preflight-invalid-baseline",
                    "guard-policy-removal",
                    "guard-equivalent-relocation",
                    "index-missing-ast",
                    "index-no-invariant",
                    "review-cross-object",
                    "review-stale-model"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": ["pass", "fail"]
                },
                "outcome": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "commands": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "severity", "scenario", "problem", "evidence", "recommended_change"],
        "properties": {
          "skill": {
            "type": "string",
            "enum": [
              "shape-lang",
              "shape-contract-preflight",
              "shape-contract-guard",
              "shape-index",
              "shape-review"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "scenario": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "recommended_change": {
            "type": "string"
          }
        }
      }
    }
  }
}
