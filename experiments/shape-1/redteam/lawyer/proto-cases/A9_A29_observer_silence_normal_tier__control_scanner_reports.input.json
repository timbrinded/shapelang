       ]
      },
      {
       "decl": "component",
       "name": "ShapeRuleEngine",
       "paths": [
        "packages/shp-checker/src/checker/rules/**/*.ts"
       ],
       "grants": [
        "Read<ShapeSource>"
       ]
      },
      {
       "decl": "rule",
       "name": "CheckerNeverReadsClock",
       "tier": "normal",
       "clauses": [
        {
         "forbid": "effect",
         "atom": "Read<SystemClock>",
         "within": [
          "component ShapeRuleEngine"
         ]
        }
       ]
      },
      {
       "decl": "provider",
       "name": "tsClockScan",
       "produces": [
        "observation"
       ],
       "observes": [
        "effect(ts.call(\"Date.now\"))",
        "effect(ts.call(\"Date\"))",
        "effect(ts.call(\"performance.now\"))",
        "effect(ts.call(\"process.hrtime\"))"
       ],
       "sound": [
        "presence",
