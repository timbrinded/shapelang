       ]
      },
      {
       "decl": "resource",
       "name": "SystemClock",
       "bind": [
        "ts.call(\"Date.now\")",
        "ts.call(\"Date\")",
        "ts.call(\"performance.now\")",
        "ts.call(\"process.hrtime\")"
       ]
      },
      {
       "decl": "resource",
       "name": "ShapeSource"
      },
      {
       "decl": "component",
       "name": "ShpCli",
       "paths": [
