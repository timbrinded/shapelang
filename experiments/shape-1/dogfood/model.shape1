rule grammar_contract_providers {
  forbid edge provides from * to shape.language::GeneratedAstContract except from shape.language::ShapeGrammar
  forbid edge provides from * to shape.language::ParsedShapeModule except from shape.language::ShapeParser
  forbid edge provides from * to shape.language::ShapeLanguageDefinition except from shape.language::ShapeGrammar
}

note DocsShapeBlockParsingContract : memory {
  about unit shape.language::DocsShapeBlockVerifier.verifyShapeCodeBlocks
  owner shape.governance::ShapeMaintainers
  text "Docs examples must be parsed with the repo parser unless explicitly marked no-verify."
  confidence high
}

note GrammarMemoryGuardForms : memory {
  about unit shape.language::ShapeGrammar.generateAst
  owner shape.governance::ShapeMaintainers
  text "Grammar changes ripple to the generated AST, parser, checker, formatter, and docs; the memory-guard protects clause supports a shape-trait form with a value and a valueless description form, guards support on_change require and forbid transform forms alongside modify-fn transform intent, review governance adds role, policy, and sensitive keywords, traits support require_context obligations, forbidden paths require explicit endpoints and relation kinds, and rationale/memory members may be grouped in nested protects/guards/who/when blocks that lower to the flat form; new keywords must also be reserved in the AST generator."
  confidence high
}

note ParseDocumentContract : memory {
  about unit shape.language::ShapeParser.parseShapeModule
  owner shape.governance::ShapeMaintainers
  text "Parser output must preserve Langium document state, source URI, module-qualified references, candidate effect and forbidden path syntax, and parse diagnostics for downstream checker and editor use."
  confidence high
}

law GrammarDocumented = std::DocumentedBy<ShapeGrammar, code raw("docs-site/src/content/docs/reference/language-syntax.md")> {
  tier normal
  evidence judged
}

law DocsVerifierDocumented = std::DocumentedBy<DocsShapeBlockVerifier, code raw("docs-site/src/content/docs/inside-shape/langium-grammar.md")> {
  tier normal
  evidence judged
}

law GrammarSupportsGuardForms = shape.governance::Property<ShapeParser.parseShapeModule, "the grammar supports the listed protects/guards/governance/require_context/forbid path/grouping forms"> {
  tier normal
  evidence tested by shape.governance::bunTest
}

law ParserPreservesDocumentState = shape.governance::Property<ShapeParser.parseShapeModule, "parser output preserves document state, URI, qualified refs, candidate/forbidden-path syntax and diagnostics"> {
  tier normal
  evidence tested by shape.governance::bunTest
}

