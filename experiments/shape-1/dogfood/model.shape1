law SkillsReportReusedOnlyWhenUnchanged = shape.governance::Property<CiPipeline.reuseReleaseSkillsEvaluation, "a report is copied from this SHA's approved run, or from an ancestor only when no relevant path changed"> {
  tier normal
  evidence tested by shape.governance::bunTest
}

module shape.governance
import std

shape Shape { owner ShapeMaintainers policy ShapePolicy }

actor timbrinded { kind person identity github("timbrinded") }

actor ShapeMaintainers { kind team member timbrinded }

actor claude { kind agent operator timbrinded identity github("claude[bot]") }

policy ShapePolicy {
  tier low { floor declared max_age 365 days judges owner, agents }
  tier normal { floor declared blocks latent loosening max_age 180 days judges owner, agents }
  tier critical { floor tested blocks unestablished, coverage, latent loosening max_age 90 days judges owner }
  judgment budget 3 per change
}

template Idempotent<F: unit> {
  law {
    evidence tested
  }
}

template ShortestWitness<F: unit> {
  law {
    evidence tested
  }
}

template Property<F: unit, Statement: value> {
  law {
    evidence tested
  }
}

provider bunTest {
  produces test
  decides template shape.governance::Property
  decides template shape.governance::Idempotent
  decides template shape.governance::ShortestWitness
  decides template std::Deterministic
  sound presence
  identity ed25519("daa0dccee98887cb1c203655e7dd486ad0e9939e928163d71217e3ac7c92db98")
  implementation { bind paths { "package.json" "bun.lock" "tsconfig.json" "experiments/shape-1/dogfood/providers/bun-test.ts" "experiments/shape-1/dogfood/providers/common.ts" } }
}

provider tsClockScan {
  produces observation
  observes effect(ts.call("Date.now")), effect(ts.call("Date")), effect(ts.call("performance.now")), effect(ts.call("process.hrtime"))
  sound presence, absence
  identity ed25519("0ad5f48ae7f2a0762b7ffd3c0fca49d747c1b73fa81c7de81b94d3096bc52858")
  implementation { bind paths { "experiments/shape-1/dogfood/providers/ts-clock-scan.ts" "experiments/shape-1/dogfood/providers/ts-ident.ts" "experiments/shape-1/dogfood/providers/common.ts" } }
}

provider tsCalls {
  produces observation
  observes call(ts)
  sound presence
  identity ed25519("c7543debaa33fd4aa03ef3ac9f6a39ff3043c9a6e4cd58a5a16209c6c549af76")
  implementation { bind paths { "experiments/shape-1/dogfood/providers/ts-calls.ts" "experiments/shape-1/dogfood/providers/ts-ident.ts" "experiments/shape-1/dogfood/providers/common.ts" } }
}

rule NoHatchesOutsideBoundaries = std::HatchesStayAtBoundaries {
  tier normal
}

