rule checker_contract_providers {
  forbid edge provides from * to shape.checker::EffectiveShapeModel except from shape.checker::ShapeModelLowerer
  forbid edge provides from * to shape.checker::HumanReadableDiagnostics except from shape.checker::ShapeDiagnostics
  forbid edge provides from * to shape.checker::MachineReadableShapeModel except from shape.checker::ShapeChecker
  forbid edge provides from * to shape.checker::NormalizedShapeReference except from shape.checker::ShapeStringHelpers
  forbid edge provides from * to shape.checker::PreludeMetadata except from shape.checker::ShapePreludeRegistry
  forbid edge provides from * to shape.checker::SemanticDiagnosticSet except from shape.checker::ShapeRuleEngine
  forbid edge provides from * to shape.checker::ShapeConformance except from shape.checker::ShapeChecker
  forbid edge provides from * to shape.checker::ShapeFacts except from shape.checker::ShapeModelLowerer
}

rule no_runtime_dependency_cycles {
  forbid cycle over calls
}

note AtomicChangePlanning : memory {
  about unit shape.checker::ShapeModelLowerer.lowerChange
  owner shape.governance::ShapeMaintainers
  text "Each change declaration is applied to an isolated effective-model snapshot; ordered before/after target transitions produce normalized guard events, and the complete plan is committed only after every entry has been staged."
  confidence high
}

note BindingDocsCouplingContract : memory {
  about unit shape.checker::ShapeBindings.checkBindings
  owner shape.governance::ShapeMaintainers
  text "Bindings enforce review coupling against normalized repo-relative changed-file paths; an allowed attestation counts only when it is new relative to the base model, or, without a base, when its declaring Shape file changed. With a base, a Shape file that changed only in attestations does not trigger a binding."
  confidence high
}

note CheckPipelineOrder : memory {
  about unit shape.checker::ShapeChecker.checkShapeModules
  owner shape.governance::ShapeMaintainers
  text "The checker must lower the effective model before semantic rules and coverage/binding checks run."
  confidence high
}

note CoverageCurrentUpdateContract : memory {
  about unit shape.checker::ShapeRuleEngine.checkCoverage
  owner shape.governance::ShapeMaintainers
  text "Coverage accepts a source reference only when its declaring Shape file matches the current changed-file input after path normalization; an attestation counts only when it is new relative to the base model, or, without a base, when its declaring Shape file changed."
  confidence high
}

note DiagnosticContract : memory {
  about unit shape.checker::ShapeDiagnostics.formatDiagnostics
  owner shape.governance::ShapeMaintainers
  text "Diagnostics are a product surface and must keep causal paths understandable for reviewers."
  confidence high
}

note FinalForbidPrecedence : memory {
  about unit shape.checker::ShapeRuleEngine.deriveFinalForbidsForResource
  owner shape.governance::ShapeMaintainers
  text "Final forbids must remain stronger than component grants, resolve concrete targets deterministically, and cannot be waived by rationale or memory."
  confidence high
}

note ForbiddenPathWitness : memory {
  about unit shape.checker::ShapeRuleEngine.findShortestPath
  owner shape.governance::ShapeMaintainers
  text "Forbidden path diagnostics must choose a deterministic fewest-hop directed witness and preserve relation kind, name, and provenance for every hop."
  confidence high
}

note FreshnessDeterminism : memory {
  about unit shape.checker::ShapeRuleEngine.checkFreshness
  owner shape.governance::ShapeMaintainers
  text "Freshness compares review_by against a caller-injected ISO date, never the system clock, and enforces only ISO YYYY-MM-DD values so checks stay deterministic."
  confidence high
}

note GuardedChangePrecision : memory {
  about unit shape.checker::ShapeRuleEngine.checkGuardedChanges
  owner shape.governance::ShapeMaintainers
  text "Guards fire property-level when every protected property is detectable (a named shape trait or the description), forbid-transform guards fire when a change declares the matching transform intent, and function, component, resource, and relation targets otherwise fall back to coarse modify/remove matching, so existing coarse guards keep their behaviour and final forbids are never waived."
  confidence high
}

note GuardedSourceCurrency : memory {
  about unit shape.checker::ShapeRuleEngine.checkGuardedSources
  owner shape.governance::ShapeMaintainers
  text "An edit to a guarded function's source is cleared only by a reevaluation written for that change. Counting any valid reevaluation, as declared changes do, would let one old review switch the guard off for every later edit."
  confidence high
}

note HypercycleWitness : memory {
  about unit shape.checker::ShapeRuleEngine.findHypercycle
  owner shape.governance::ShapeMaintainers
  text "Hypercycle diagnostics need a deterministic shortest witness path so reviewers can understand the tightest rejected structural relation."
  confidence high
}

note InspectionSchemaContract : memory {
  about unit shape.checker::ShapeChecker.inspectShapeModules
  owner shape.governance::ShapeMaintainers
  text "The inspection DTO is explicitly versioned, uses stable module-qualified identities, preserves authored or generated-AST origin, uses codepoint ordering, normalizes files at the CLI boundary, and never embeds the current time."
  confidence high
}

note LoweringBeforeRules : memory {
  about unit shape.checker::ShapeModelLowerer.lowerShapeModules
  owner shape.governance::ShapeMaintainers
  text "Module-scoped declarations, concrete forbid targets, generated candidate evidence, and change declarations must be resolved into the final effective model before derived facts are emitted."
  confidence high
}

note PreludeMetadataContract : memory {
  about unit shape.checker::ShapePreludeRegistry.definePreludeMetadata
  owner shape.governance::ShapeMaintainers
  text "Prelude traits, relation kinds, and context requirements are semantic inputs shared by checker, editor, and authoring surfaces; context requirements derive obligations for function, component, and resource targets, and are merged with user-defined trait require_context obligations during checking."
  confidence high
}

note ReevaluationPolicyContract : memory {
  about unit shape.checker::ShapeRuleEngine.checkReevaluations
  owner shape.governance::ShapeMaintainers
  text "Reevaluation validation requires structural fields plus an approver when a project policy requires one for a sensitive memory, and validates reviewer/approver against declared roles; approver and role checks stay opt-in so the default reviewer-only path is preserved."
  confidence high
}

note RuleLayerSplit : memory {
  about unit shape.checker::ShapeChecker.checkRuleLoosening
  owner shape.governance::ShapeMaintainers
  text "The loosening check restores only the rule layer (traits, rules, memory, rationale, implementations, bindings, roles, policies, and trait lists) from the base and takes every claim about the code from the head. Moving a declaration kind across that line changes which edits count as loosening, so a coding agent could silence a violation through a kind the check treats as a claim."
  confidence high
}

note ShapeSourceNormalizationContract : memory {
  about unit shape.checker::ShapeStringHelpers.normalizeShapeSourcePath
  owner shape.governance::ShapeMaintainers
  text "Source-reference normalization must keep coverage, binding, and analyzer comparisons using the same repo-relative path rules."
  confidence high
}

note ShapeStringLiteralContract : memory {
  about unit shape.checker::ShapeStringHelpers.unquoteShapeString
  owner shape.governance::ShapeMaintainers
  text "Shape string literal unquoting must stay consistent across lowering and formatting."
  confidence high
}

note SharedCheckPipelineOrder : memory {
  about unit shape.checker::ShapeChecker.checkLoweredShapeModel
  owner shape.governance::ShapeMaintainers
  text "The shared lowered-model pipeline must retain model diagnostics, semantic rules, binding checks, canonical diagnostic sorting, and optional fact output in that order."
  confidence high
}

rule CheckerNeverReadsClock {
