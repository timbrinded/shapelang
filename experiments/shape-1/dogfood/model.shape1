rule tooling_contract_providers {
  forbid edge provides from * to shape.tooling::CanonicalShapeFormat except from shape.tooling::ShapeFormatter
  forbid edge provides from * to shape.tooling::CommandLineInterface except from shape.tooling::ShpCli
  forbid edge provides from * to shape.tooling::LanguageServerProtocol except from shape.tooling::ShapeLanguageServer
}

note AstGenerationUnknownSafety : memory {
  about unit shape.tooling::ShapeAstGenerator.generateShapeFromCodeSemanticGraph
  owner shape.governance::ShapeMaintainers
  text "AST-derived architecture drafts must preserve uncertainty with effects unknown, use stable symbol or file references that do not churn on line-only movement, include compact syntax anchors with semantic fingerprints when token evidence exists, warn instead of failing on tokenless anchors, emit candidate effect evidence only as review hints with checkable pins, and keep raw syntax traces opt-in."
  confidence high
}

note AuthorPromptSafetyRules : memory {
  about unit shape.tooling::ShapeAuthoring.buildShapeAuthorPrompt
  owner shape.governance::ShapeMaintainers
  text "Authoring prompts must require stable symbol or file evidence without line suffixes, explicit destructive effects, and no memory waiver for final forbids."
  confidence high
}

note AuthoringUnknownSafety : memory {
  about unit shape.tooling::ShapeAuthoring.generateShapeUpdateDraft
  owner shape.governance::ShapeMaintainers
  text "Generated model drafts must prefer effects unknown over false empty complete summaries."
  confidence high
}

note CliCommandDispatchOrder : memory {
  about unit shape.tooling::ShpCli.main
  owner shape.governance::ShapeMaintainers
  text "CLI commands must dispatch to the same checker/formatter/helper semantics used by tests, reject ambiguous output modes before running command work, make generated AST directory checks explicit, and derive generated AST source identity from the workspace root."
  confidence high
}

note ClockReadAtCliBoundary : memory {
  about unit shape.tooling::ShpCli.isoToday
  owner shape.governance::ShapeMaintainers
  text "The system clock is read only at the CLI boundary to inject a freshness date; the checker never reads the clock so freshness checking stays deterministic."
  confidence high
}

note CriticPromptSafetyRules : memory {
  about unit shape.tooling::ShapeAuthoring.buildShapeCriticPrompt
  owner shape.governance::ShapeMaintainers
  text "Critic prompts must flag unstable numbered references, omitted destructive effects, false certainty, missing reevaluations, and attempted waivers of final forbids."
  confidence high
}

note DefaultShapeFileDiscovery : memory {
  about unit shape.tooling::ShpCli.defaultShapeFiles
  owner shape.governance::ShapeMaintainers
  text "Default discovery loads every Shape file under the shape directory, including source-controlled domain packs in nested vendor directories."
  confidence high
}

note FormatterCanonicalDiffs : memory {
  about unit shape.tooling::ShapeFormatter.formatShapeModule
  owner shape.governance::ShapeMaintainers
  text "Formatter ordering and indentation keep Shape files reviewable and stable in diffs, nested rationale/memory grouping blocks are canonicalized to their flat members, and graph-rule endpoints and kind filters have one canonical on-disk form."
  confidence high
}

note UpdateBinaryIntegrity : memory {
  about unit shape.tooling::ShpCli.updateInstalledBinary
  owner shape.governance::ShapeMaintainers
  text "Self-update must verify any existing target binary identity, release checksum, downloaded binary version, and bundled runtime parser assets before replacing the local executable."
  confidence high
}

rule ClockReadOnlyAtCliBoundary {
  forbid Read<SystemClock> within component ShpCli, component ShapeAnalyzer, component ShapeAstGenerator, component ShapeAuthoring, component ShapeEditorServices, component ShapeFormatter, component ShapeLanguageServer, component shape.language::ShapeParser, component shape.language::ShapeGrammar except unit ShpCli.isoToday, unit ShpCli.main
  tier normal
}

rule AnalyzerStaysAdvisory {
  forbid path ShapeAnalyzer -> shape.checker::ShapeChecker over calls
  tier normal
}

note AnalyzerCheckerSeparation : rationale {
  about rule AnalyzerStaysAdvisory, component ShapeAnalyzer
  owner shape.governance::ShapeMaintainers
  text "The analyzer compares source hints directly with parsed Shape and remains advisory; it does not call the authoritative deterministic checker."
}

exception UpdateTempTokenReadsClock {
  waives contradiction of rule ClockReadOnlyAtCliBoundary for code ts("packages/shp-cli/src/commands/update/impl.ts#replaceWindowsBinary")
  owner shape.governance::ShapeMaintainers
  expires "2027-04-30"
}

