  about unit shape.delivery::CiPipeline.reuseReleaseSkillsEvaluation
  owner shape.governance::ShapeMaintainers
  text "A skills report may be copied from this SHA's approved run, or from an ancestor when git diff --name-only --no-renames has no path under SKILLS_RELEVANT_PATH_PREFIXES. Publishing still requires an approved candidate run on the exact tag SHA."
