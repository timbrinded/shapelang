boundary ShpCli {
  tier normal
  assumes GitReportsRepositoryState "git ls-files and git merge-base report the repository's tracked files and change base."
  assumes GitHubReleasesAuthentic "GitHub release metadata and checksums.txt come from the Shape release workflow."
  unit isoToday
}

boundary ShapeAstGenerator {
  tier normal
  assumes TreeSitterParsersFaithful "Bundled tree-sitter grammars parse each supported language as its compiler does."
}

