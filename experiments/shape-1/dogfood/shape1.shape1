boundary CiPipeline {
  tier critical
  assumes ClaudeReviewIsAdvisory "Claude review jobs report findings; the deterministic checker, not the model, decides the gate."
  assumes GitHubReportsTheChange "The pull request event and git merge-base name the change under review."
  unit runShapeCi {
    bind gha(".github/workflows/shape.yml#jobs.shape.steps.5")
  }
  unit runExperimentalSemanticKernel {
    bind gha(".github/workflows/shape.yml#jobs.semantic-kernel.steps.6")
  }
}

