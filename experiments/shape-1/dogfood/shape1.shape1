}

rule CheckerNeverReadsClock {
  forbid Read<shape.tooling::SystemClock> within component ShapeChecker, component ShapeRuleEngine, component ShapeModelLowerer, component ShapeBindings, component ShapePreludeRegistry, component ShapeModuleResolver, component ShapeStringHelpers, component ShapeDiagnostics, component shape.checker.incremental::ShapeIncrementalChecker
  tier critical
}

