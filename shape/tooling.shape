      Append<AnalyzerHint>
        evidence ts("packages/shp-checker/src/analyzer.ts")
      Read<NormalizedShapeReference>
        evidence ts("packages/shp-checker/src/analyzer.ts")
      Read<ShapeSource>
        evidence ts("packages/shp-checker/src/analyzer.ts")
    }
}

