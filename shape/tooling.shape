rule tooling_contract_providers {
  forbid provides CanonicalShapeFormat except ShapeFormatter
  forbid provides CommandLineInterface except ShpCli
  forbid provides LanguageServerProtocol except ShapeLanguageServer
}

rationale AnalyzerCheckerSeparation : DesignRationale<component ShapeAnalyzer> {
  applies_to component ShapeAnalyzer
  why AdvisoryBoundary
  summary "The analyzer compares source hints directly with parsed Shape and remains advisory; it does not call the authoritative deterministic checker."
  who {
    owner ShapeMaintainers
  }
  evidence ts("packages/shp-checker/src/analyzer-shape.ts#compareAnalyzerHintsToShape")
}

memory AstGenerationUnknownSafety : RefactorConstraint<fn ShapeAstGenerator.generateShapeFromCodeSemanticGraph> {
  applies_to fn ShapeAstGenerator.generateShapeFromCodeSemanticGraph
  status Explained
  confidence High
  summary "AST-derived architecture drafts must preserve uncertainty with effects unknown, use stable symbol or file references that do not churn on line-only movement, include compact syntax anchors with semantic fingerprints when token evidence exists, warn instead of failing on tokenless anchors, emit candidate effect evidence only as review hints with checkable pins, and keep raw syntax traces opt-in."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape GeneratedAstDraftSafety
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory AuthorPromptSafetyRules : RefactorConstraint<fn ShapeAuthoring.buildShapeAuthorPrompt> {
  applies_to fn ShapeAuthoring.buildShapeAuthorPrompt
  status Explained
  confidence High
  summary "Authoring prompts must require stable symbol or file evidence without line suffixes, explicit destructive effects, and no memory waiver for final forbids."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape AgentReviewSafety
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory AuthoringUnknownSafety : RefactorConstraint<fn ShapeAuthoring.generateShapeUpdateDraft> {
  applies_to fn ShapeAuthoring.generateShapeUpdateDraft
  status Explained
  confidence High
  summary "Generated model drafts must prefer effects unknown over false empty complete summaries."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ExplicitUnknowns
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory CliCommandDispatchOrder : CheckOrderRationale<fn ShpCli.main> {
  applies_to fn ShpCli.main
  status Explained
  confidence High
  summary "CLI commands must dispatch to the same checker/formatter/helper semantics used by tests, reject ambiguous output modes before running command work, make generated AST directory checks explicit, and derive generated AST source identity from the workspace root."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape CommandDispatch
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ClockReadAtCliBoundary : RefactorConstraint<fn ShpCli.isoToday> {
  applies_to fn ShpCli.isoToday
  status Explained
  confidence High
  summary "The system clock is read only at the CLI boundary to inject a freshness date; the checker never reads the clock so freshness checking stays deterministic."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape DeterministicFreshness
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory CriticPromptSafetyRules : RefactorConstraint<fn ShapeAuthoring.buildShapeCriticPrompt> {
  applies_to fn ShapeAuthoring.buildShapeCriticPrompt
  status Explained
  confidence High
  summary "Critic prompts must flag unstable numbered references, omitted destructive effects, false certainty, missing reevaluations, and attempted waivers of final forbids."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape AgentReviewSafety
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory DefaultShapeFileDiscovery : RefactorConstraint<fn ShpCli.defaultShapeFiles> {
  applies_to fn ShpCli.defaultShapeFiles
  status Explained
  confidence High
  summary "Default discovery loads every Shape file under the shape directory, including source-controlled domain packs in nested vendor directories."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape DefaultFileSet
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory FormatterCanonicalDiffs : RefactorConstraint<fn ShapeFormatter.formatShapeModule> {
  applies_to fn ShapeFormatter.formatShapeModule
  status Explained
  confidence High
  summary "Formatter ordering and indentation keep Shape files reviewable and stable in diffs, nested rationale/memory grouping blocks are canonicalized to their flat members, and graph-rule endpoints and kind filters have one canonical on-disk form."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape CanonicalFormatting
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory UpdateBinaryIntegrity : RefactorConstraint<fn ShpCli.updateInstalledBinary> {
  applies_to fn ShpCli.updateInstalledBinary
  status Explained
  confidence High
  summary "Self-update must verify any existing target binary identity, release checksum, downloaded binary version, and bundled runtime parser assets before replacing the local executable."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ReleaseIntegrity
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

