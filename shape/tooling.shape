reevaluation FormatterDispatchConsolidated {
  satisfies memory FormatterCanonicalDiffs
  outcome Confirmed
  summary "Shared AST and typed member rendering preserve canonical output, context aggregation, and change-entry ordering. Declaration dispatch directly renders simple blocks, eliminating forwarding helpers without changing headers or member ordering. Members are grouped once by each owner's explicit order before sorting within groups. Shared type-reference suffixes and directly projected implementation path blocks preserve sorting, duplicates, escaping, and owner-specific block order. Corpus and member-variant comparisons preserve spacing, evidence, duplicate handling, and the specialized resource, relation, implementation, and candidate-effect paths."
  reviewer Codex
  decided_on "2026-09-26"
  evidence test("packages/shp-checker/src/behavioural/formatter-roundtrip.test.ts")
  evidence test("packages/shp-checker/src/formatter.test.ts")
}

reevaluation FormatterSharedStringHelpersRechecked {
  satisfies memory FormatterCanonicalDiffs
  outcome Confirmed
  summary "Formatter canonical output is preserved while quote handling is shared with checker string helpers."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/shape-strings.test.ts")
}

reevaluation SwiftDraftEvidenceRechecked {
  satisfies memory AstGenerationUnknownSafety
  outcome Confirmed
  summary "Swift drafts retain unknown effects and omit inferred calls and candidate effects. Real-parser regressions cover qualified overload and extension refs, protocol requirements, executable property bodies, excluded nested local types with colliding names, and literal-sensitive fingerprints that ignore unrelated formatting."
  reviewer ShapeMaintainers
  decided_on "2026-09-07"
  evidence test("packages/shp-checker/src/ast-generation-swift.test.ts")
  evidence test("packages/shp-cli/src/index.test.ts")
}

