relation CheckShapesWithShpCheck {
  kind coordinated_call
  connects ShpCli -> ShapeChecker -> ShapeParser -> ShapeModelLowerer -> ShapeRuleEngine -> ShapeBindings -> ShapeDiagnostics
  roles { ShapeBindings as bind, ShapeChecker as orchestrate, ShapeDiagnostics as report, ShapeModelLowerer as lower, ShapeParser as parse, ShapeRuleEngine as validate, ShpCli as dispatch }
  summary "Checking shapes with shp check across the authored validation pipeline."
}

relation ShapeAnalyzerUsesStringHelpers {
  kind calls
  connects ShapeAnalyzer -> ShapeStringHelpers
  summary "SourcePathNormalization"
}

relation ShapeAstGeneratorProvidesDraft {
  kind provides
  connects ShapeAstGenerator -> ShapeModelDraft
}

relation ShapeAstGeneratorUsesGrammar {
  kind calls
  connects ShapeAstGenerator -> ShapeGrammar
  summary "GeneratedKeywordVocabulary"
}

relation ShapeAuthoringUsesAnalyzer {
