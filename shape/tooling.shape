relation ShapeAnalyzerUsesChecker {
  kind calls
  connects ShapeAnalyzer -> ShapeChecker
  summary "AnalyzerComparison"
}

relation ShapeAnalyzerUsesStringHelpers {
  kind calls
  connects ShapeAnalyzer -> ShapeStringHelpers
  summary "SourcePathNormalization"
}

relation ShapeAstGeneratorProvidesDraft {
  kind provides
  connects ShapeAstGenerator -> ShapeModelDraft
}

relation ShapeAuthoringUsesChecker {
  kind calls
  connects ShapeAuthoring -> ShapeChecker
  summary "ModelDraftValidation"
}

relation ShapeAuthoringUsesPreludeRegistry {
  kind calls
  connects ShapeAuthoring -> ShapePreludeRegistry
  summary "PromptPreludeRules"
}

relation ShapeEditorUsesChecker {
  kind calls
  connects ShapeEditorServices -> ShapeChecker
  summary "EditorDiagnostics"
}

relation ShapeEditorUsesFormatter {
  kind calls
  connects ShapeEditorServices -> ShapeFormatter
  summary "EditorFormatting"
}

relation ShapeEditorUsesParser {
  kind calls
  connects ShapeEditorServices -> ShapeParser
  summary "EditorParsing"
}

relation ShapeEditorUsesPreludeRegistry {
  kind calls
  connects ShapeEditorServices -> ShapePreludeRegistry
  summary "EditorPreludeHelp"
}

relation ShapeFormatterProvidesFormat {
  kind provides
  connects ShapeFormatter -> CanonicalShapeFormat
}

relation ShapeFormatterUsesParser {
  kind calls
  connects ShapeFormatter -> ShapeParser
  summary "FormattingParser"
}

relation ShapeFormatterUsesStringHelpers {
  kind calls
  connects ShapeFormatter -> ShapeStringHelpers
  summary "LiteralNormalization"
}

relation ShpCliProvidesInterface {
  kind provides
  connects ShpCli -> CommandLineInterface
}

relation ShpCliUsesAnalyzer {
  kind calls
  connects ShpCli -> ShapeAnalyzer
  summary "AnalyzeCommand"
}

relation ShpCliUsesAstGenerator {
  kind calls
  connects ShpCli -> ShapeAstGenerator
  summary "AstCommand"
}

relation ShpCliUsesAuthoring {
  kind calls
  connects ShpCli -> ShapeAuthoring
  summary "AuthorCommand"
}

relation ShpCliUsesChecker {
  kind calls
  connects ShpCli -> ShapeChecker
  summary "CheckCommand"
}

relation ShpCliUsesDiagnostics {
  kind calls
  connects ShpCli -> ShapeDiagnostics
  summary "DiagnosticOutput"
}

relation ShpCliUsesFormatter {
  kind calls
  connects ShpCli -> ShapeFormatter
  summary "FormatCommand"
}

rule tooling_contract_providers {
  forbid provides CanonicalShapeFormat except ShapeFormatter
  forbid provides CommandLineInterface except ShpCli
}

memory AstGenerationUnknownSafety : RefactorConstraint<fn ShapeAstGenerator.generateShapeFromCodeSemanticGraph> {
  applies_to fn ShapeAstGenerator.generateShapeFromCodeSemanticGraph
  status Explained
  confidence High
  summary "AST-derived architecture drafts must preserve uncertainty with effects unknown, include compact syntax anchors, and keep raw syntax traces opt-in."
  owner ShapeMaintainers
  protects shape GeneratedAstDraftSafety
  guards on_change require ReEvaluation<Self>
}

memory AuthoringUnknownSafety : RefactorConstraint<fn ShapeAuthoring.generateShapeUpdateDraft> {
  applies_to fn ShapeAuthoring.generateShapeUpdateDraft
  status Explained
  confidence High
  summary "Generated model drafts must prefer effects unknown over false empty complete summaries."
  owner ShapeMaintainers
  protects shape ExplicitUnknowns
  guards on_change require ReEvaluation<Self>
}

memory AuthorPromptSafetyRules : RefactorConstraint<fn ShapeAuthoring.buildShapeAuthorPrompt> {
  applies_to fn ShapeAuthoring.buildShapeAuthorPrompt
  status Explained
  confidence High
  summary "Authoring prompts must require evidence, explicit destructive effects, and no memory waiver for final forbids."
  owner ShapeMaintainers
  protects shape AgentReviewSafety
  guards on_change require ReEvaluation<Self>
}

memory CliCommandDispatchOrder : CheckOrderRationale<fn ShpCli.main> {
  applies_to fn ShpCli.main
  status Explained
  confidence High
  summary "CLI commands must dispatch to the same checker/formatter/helper semantics used by tests and reject ambiguous output modes before running command work."
  owner ShapeMaintainers
  protects shape CommandDispatch
  guards on_change require ReEvaluation<Self>
}

memory DefaultShapeFileDiscovery : RefactorConstraint<fn ShpCli.defaultShapeFiles> {
  applies_to fn ShpCli.defaultShapeFiles
  status Explained
  confidence High
  summary "Default discovery loads every Shape file under the shape directory, including nested subdirectories."
  owner ShapeMaintainers
  protects shape DefaultFileSet
  guards on_change require ReEvaluation<Self>
}

memory FormatterCanonicalDiffs : RefactorConstraint<fn ShapeFormatter.formatShapeModule> {
  applies_to fn ShapeFormatter.formatShapeModule
  status Explained
  confidence High
  summary "Formatter ordering and indentation keep Shape files reviewable and stable in diffs."
  owner ShapeMaintainers
  protects shape CanonicalFormatting
  guards on_change require ReEvaluation<Self>
}

memory UpdateBinaryIntegrity : RefactorConstraint<fn ShpCli.updateInstalledBinary> {
  applies_to fn ShpCli.updateInstalledBinary
  status Explained
  confidence High
  summary "Self-update must verify any existing target binary identity, release checksum, and downloaded binary version before replacing the local executable."
  owner ShapeMaintainers
  protects shape ReleaseIntegrity
  guards on_change require ReEvaluation<Self>
}

reevaluation AstGenerationDraftSafetyRechecked {
  satisfies memory AstGenerationUnknownSafety
  outcome Confirmed
  summary "AST generation tests cover semantic drafts that parse with compact AST anchors while keeping effects unknown as a review blocker and raw AST output opt-in."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation AuthoringDraftSafetyRechecked {
  satisfies memory AuthoringUnknownSafety
  outcome Confirmed
  summary "Draft generation still keeps uncertain effects explicit after the authoring prompt helper changes."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation AuthorPromptPreludeRechecked {
  satisfies memory AuthorPromptSafetyRules
  outcome Confirmed
  summary "Author prompts now derive final-forbid, context, and relation-kind guidance from the shared prelude registry."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation CliAstOutputModesRechecked {
  satisfies memory CliCommandDispatchOrder
  outcome Confirmed
  summary "AST CLI tests reject ambiguous raw trace output flags and keep source and JSON draft paths on the same generator semantics."
  reviewer ShapeMaintainers
  decided_on "2026-05-22"
  evidence test("packages/shp-cli/src/index.test.ts")
}

reevaluation CliCommandErrorsRechecked {
  satisfies memory CliCommandDispatchOrder
  outcome Confirmed
  summary "CLI dispatch now reports expected user-input failures without bypassing checker and formatter command semantics."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-cli/src/index.test.ts")
}

reevaluation CliUpdateDispatchRechecked {
  satisfies memory CliCommandDispatchOrder
  outcome Confirmed
  summary "The update command is registered through the same Stricli dispatch path and keeps usage failures normalized."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence test("packages/shp-cli/src/index.test.ts")
}

reevaluation CliUpdateExplicitTargetRechecked {
  satisfies memory UpdateBinaryIntegrity
  outcome Confirmed
  summary "Existing explicit update targets must identify as the Shape CLI and report a valid version before replacement."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence test("packages/shp-cli/src/update.test.ts")
}

reevaluation CliUpdateHelpIdentityRechecked {
  satisfies memory UpdateBinaryIntegrity
  outcome Confirmed
  summary "Explicit update target identity checks now accept stable Shape CLI help signals without requiring update-specific wording."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence test("packages/shp-cli/src/update.test.ts")
}

reevaluation DefaultShapeDiscoveryRechecked {
  satisfies memory DefaultShapeFileDiscovery
  outcome Confirmed
  summary "The CLI default load path now scans every Shape file under the shape directory."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-cli/src/index.test.ts")
}

reevaluation FormatterSharedStringHelpersRechecked {
  satisfies memory FormatterCanonicalDiffs
  outcome Confirmed
  summary "Formatter canonical output is preserved while quote handling is shared with checker string helpers."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/shape-strings.test.ts")
}
