module shape.language

import shape.checker

resource DocsShapeBlock

resource GeneratedAst

resource GeneratedAstContract

resource LangiumGrammar

resource ParsedModule

resource ParsedShapeModule

resource ShapeLanguageDefinition

resource ShapeSource

resource SyntaxHighlighting

component DocsShapeBlockVerifier {
  owns DocsShapeBlock
  grants Append<ParsedModule>
  grants Append<SemanticDiagnostics>
  grants Read<DocsShapeBlock>
  fn verifyShapeCodeBlocks : RefactorSensitive
    source ts("docs-site/scripts/verify-shape-blocks.ts")
    effects complete {
      Append<ParsedModule>
        evidence ts("docs-site/scripts/verify-shape-blocks.ts")
      Append<SemanticDiagnostics>
        evidence ts("docs-site/scripts/verify-shape-blocks.ts")
      Read<DocsShapeBlock>
        evidence ts("docs-site/scripts/verify-shape-blocks.ts")
    }
}

component ShapeGrammar {
  owns GeneratedAst
  owns LangiumGrammar
  owns SyntaxHighlighting
  grants Read<LangiumGrammar>
  grants Update<GeneratedAst>
  grants Update<ShapeLanguageDefinition>
  grants Update<SyntaxHighlighting>
  fn generateAst : RefactorSensitive
    source langium("packages/shp-checker/src/language/shape.langium")
    description "Generates the typed AST and parser grammar, including constrained forbidden path rule members with explicit endpoint and kind fields."
    effects complete {
      Read<LangiumGrammar>
        evidence langium("packages/shp-checker/src/language/shape.langium")
      Update<GeneratedAst>
        evidence ts("packages/shp-checker/src/language/generated/ast.ts")
      Update<GeneratedAst>
        evidence ts("packages/shp-checker/src/language/generated/grammar.ts")
      Update<GeneratedAst>
        evidence ts("packages/shp-checker/src/language/generated/module.ts")
      Update<ShapeLanguageDefinition>
        evidence langium("packages/shp-checker/src/language/shape.langium")
    }
  fn updateSyntaxHighlighting
    source js("docs-site/src/syntax/shape-language.mjs")
    description "Keeps documentation highlighting aligned with every reserved Shape keyword, including singular path rules."
    effects complete {
      Update<SyntaxHighlighting>
        evidence js("docs-site/src/syntax/shape-language.mjs")
    }
}

component ShapeParser {
  owns ParsedModule
  owns ShapeSource
  grants Append<ParsedModule>
  grants Append<SemanticDiagnostics>
  grants Read<ShapeSource>
  fn parseShapeModule : RefactorSensitive
    source ts("packages/shp-checker/src/parser.ts#parseShapeModule")
    effects complete {
      Append<ParsedModule>
        evidence ts("packages/shp-checker/src/parser.ts")
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/parser.ts")
      Read<ShapeSource>
        evidence ts("packages/shp-checker/src/parser.ts")
    }
}

relation DocsShapeBlockVerifierUsesParser {
  kind calls
  connects DocsShapeBlockVerifier -> ShapeParser
  summary "VerificationDependency"
}

relation ShapeGrammarProvidesAstContract {
  kind provides
  connects ShapeGrammar -> GeneratedAstContract
}

relation ShapeGrammarProvidesLanguageDefinition {
  kind provides
  connects ShapeGrammar -> ShapeLanguageDefinition
}

relation ShapeParserProvidesParsedModule {
  kind provides
  connects ShapeParser -> ParsedShapeModule
}

relation ShapeParserUsesGrammar {
  kind calls
  connects ShapeParser -> ShapeGrammar
  summary "ParserRuntime"
}

rule grammar_contract_providers {
  forbid provides GeneratedAstContract except ShapeGrammar
  forbid provides ParsedShapeModule except ShapeParser
  forbid provides ShapeLanguageDefinition except ShapeGrammar
}

memory DocsShapeBlockParsingContract : RefactorConstraint<fn DocsShapeBlockVerifier.verifyShapeCodeBlocks> {
  applies_to fn DocsShapeBlockVerifier.verifyShapeCodeBlocks
  status Explained
  confidence High
  summary "Docs examples must be parsed with the repo parser unless explicitly marked no-verify."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape DocsExampleValidity
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory GrammarMemoryGuardForms : RefactorConstraint<fn ShapeGrammar.generateAst> {
  applies_to fn ShapeGrammar.generateAst
  status Explained
  confidence High
  summary "Grammar changes ripple to the generated AST, parser, checker, formatter, and docs; the memory-guard protects clause supports a shape-trait form with a value and a valueless description form, guards support on_change require and forbid transform forms alongside modify-fn transform intent, review governance adds role, policy, and sensitive keywords, traits support require_context obligations, forbidden paths require explicit endpoints and relation kinds, and rationale/memory members may be grouped in nested protects/guards/who/when blocks that lower to the flat form; new keywords must also be reserved in the AST generator."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape GrammarContract
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ParseDocumentContract : RefactorConstraint<fn ShapeParser.parseShapeModule> {
  applies_to fn ShapeParser.parseShapeModule
  status Explained
  confidence High
  summary "Parser output must preserve Langium document state, source URI, module-qualified references, candidate effect and forbidden path syntax, and parse diagnostics for downstream checker and editor use."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ParseContract
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

reevaluation ForbiddenPathGrammarRechecked {
  satisfies memory GrammarMemoryGuardForms
  outcome Confirmed
  summary "The path keyword is reserved and highlighted, Langium generates source, target, and kinds fields, and parser, formatter, checker, editor, AST-reservation, and docs checks cover the constrained syntax."
  reviewer ShapeMaintainers
  decided_on "2026-07-26"
  evidence langium("packages/shp-checker/src/language/shape.langium")
  evidence md("docs-site/src/content/docs/inside-shape/langium-grammar.md")
  evidence test("packages/shp-checker/src/checker.guard-syntax.test.ts")
  evidence test("packages/shp-checker/src/formatter.test.ts")
  evidence test("packages/shp-checker/src/parser.test.ts")
}

reevaluation ForbiddenPathParserRechecked {
  satisfies memory ParseDocumentContract
  outcome Confirmed
  summary "Parser coverage preserves local and module-qualified forbidden path endpoints, explicit ordered kind filters, and rejects an omitted filter."
  reviewer ShapeMaintainers
  decided_on "2026-07-26"
  evidence md("docs-site/src/content/docs/reference/language-syntax.md")
  evidence test("packages/shp-checker/src/parser.test.ts")
}
