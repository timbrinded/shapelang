module shape.enforcement

import shape.checker

import shape.language

import shape.tooling

resource AttestationBundle

resource AttestationObligations

resource GitTransition

resource JevCanaryFixture

resource JevCanaryReport

resource JevEvidence

resource JevProbabilities

resource PullRequestBody

resource PullRequestCheckReport

resource SemanticRecommendation

resource SemanticReviewDecision

component JevEnforcementSkill {
  grants Append<JevProbabilities>
  grants Append<SemanticRecommendation>
  grants Append<SemanticReviewDecision>
  grants Read<AttestationBundle>
  grants Read<GitTransition>
  grants Read<JevEvidence>
  grants Read<JevProbabilities>
  grants Read<SemanticDiagnostics>
  grants Update<JevEvidence>
  grants Update<JevProbabilities>
  grants Update<SemanticRecommendation>
  fn evaluateJev
    source ts("plugins/shapelang/skills/shape-lang/scripts/jev-enforcement.ts#evaluateJev")
    description "Optional network enrichment with fixed questions, bounded evidence and response bodies, strict probabilities, one retry within a shared deadline and retained safe rejected-attempt diagnostics. No dependency from the deterministic checker."
    effects complete {
      Append<JevProbabilities>
      Read<JevEvidence>
    }
  fn runJevEnforcement
    source ts("scripts/run-jev-enforcement.ts#runJevEnforcement")
    description "Reviews every initial coverage obligation, including claims later accepted by the deterministic checker, using exact committed evidence without an orchestrating model. Clears prior per-obligation artifacts and records failures explicitly."
    effects complete {
      Read<AttestationBundle>
        evidence ts("scripts/validate-jev-artifacts.ts#readEnforcementContext")
      Read<GitTransition>
        evidence ts("scripts/assemble-jev-evidence.ts#assembleEvidence")
      Read<SemanticDiagnostics>
        evidence ts("scripts/validate-jev-artifacts.ts#readEnforcementContext")
      Update<JevEvidence>
        evidence ts("scripts/run-jev-enforcement.ts#runJevEnforcement")
      Update<JevProbabilities>
        evidence ts("scripts/run-jev-enforcement.ts#runJevEnforcement")
      Update<SemanticRecommendation>
        evidence ts("scripts/validate-jev-artifacts.ts#publishSemanticReport")
    }
  fn semanticExitCode
    source ts("scripts/validate-jev-artifacts.ts#semanticExitCode")
    description "Independent opt-in policy gate for high-confidence required model updates or unsupported attestations. Provider failures have a separate policy; architectural scope alone and uncertainty do not count as contradictions. Never clears a deterministic failure."
    effects complete {
      Append<SemanticReviewDecision>
        evidence ts("scripts/validate-jev-artifacts.ts#semanticExitCode")
      Read<JevProbabilities>
        evidence ts("scripts/validate-jev-artifacts.ts#semanticExitCode")
    }
  fn validateArtifacts
    source ts("scripts/validate-jev-artifacts.ts#validateArtifacts")
    description "Validates stored assessments against initial exact-transition obligations and the current PR rationale, retaining distributions, provider errors and separate policy outcomes."
    effects complete {
      Append<SemanticRecommendation>
      Read<AttestationBundle>
        evidence ts("scripts/validate-jev-artifacts.ts#readEnforcementContext")
      Read<JevEvidence>
      Read<JevProbabilities>
      Read<SemanticDiagnostics>
        evidence ts("scripts/validate-jev-artifacts.ts#readEnforcementContext")
    }
}

component JevEvidenceAssembler {
  grants Append<JevEvidence>
  grants Read<GitTransition>
  grants Read<ShapeSource>
  fn assembleEvidence
    source ts("scripts/assemble-jev-evidence.ts#assembleEvidence")
    description "Reads exact base/head Git blobs, complete changed source and source-anchored authored declarations with dependent policies. Missing, ambiguous or oversized context fails explicitly; generated candidates are not architecture authority."
    effects complete {
      Append<JevEvidence>
        evidence ts("scripts/assemble-jev-evidence.ts#assembleEvidence")
      Read<GitTransition>
        evidence ts("scripts/assemble-jev-evidence.ts#assembleEvidence")
      Read<ShapeSource>
        evidence ts("scripts/assemble-jev-evidence.ts#loadSnapshot")
    }
}

component JevLiveCanary {
  owns JevCanaryFixture
  grants Append<JevCanaryReport>
  grants Read<SemanticRecommendation>
  grants Update<JevCanaryFixture>
  fn runCanary
    source ts("scripts/jev-canary.ts#runJevCanary")
    description "Creates isolated committed synthetic append-only stores, proves structurally valid PR attestations clear coverage, then requires a live rename acceptance and blocking semantic verdicts for destructive false claims with and without prompt injection. Retains actual provider evidence and decisions."
    effects complete {
      Append<JevCanaryReport>
        evidence ts("scripts/jev-canary.ts#runJevCanary")
      Read<SemanticRecommendation>
        evidence ts("scripts/jev-canary.ts#runJevCanary")
      Update<JevCanaryFixture>
        evidence ts("scripts/jev-canary.ts#runJevCanary")
    }
}

component PullRequestEvidenceWorkflow {
  grants Append<AttestationBundle>
  grants Append<PullRequestCheckReport>
  grants Append<SemanticDiagnostics>
  grants Read<AttestationBundle>
  grants Read<GitTransition>
  grants Read<PullRequestBody>
  grants Read<SemanticDiagnostics>
  grants Update<PullRequestBody>
  fn checkPullRequest
    source ts("scripts/check-pr.ts#checkPullRequest")
    description "Checks the current exact transition and PR body from an explicit checkout; removes stale prior evidence before extracting the current block. Hosted deterministic and optional semantic jobs retain artifacts independently."
    effects complete {
      Append<AttestationBundle>
      Append<SemanticDiagnostics>
      Read<GitTransition>
      Read<PullRequestBody>
    }
  fn extractAttestations
    source ts("scripts/pr-attestations.ts#extractAttestations")
    effects complete {
      Append<AttestationBundle>
      Read<PullRequestBody>
    }
  fn renderCheckReport
    source ts("scripts/report-pr-check.ts#renderCheckReport")
    description "Renders only the final deterministic result as readable logs, escaped GitHub annotations and a Markdown summary, preserving JSON artifacts and the checker exit status."
    effects complete {
      Append<PullRequestCheckReport>
      Read<SemanticDiagnostics>
    }
  fn replaceAttestations
    source ts("scripts/pr-attestations.ts#replaceAttestations")
    description "Replaces only the marked section while preserving unrelated prose."
    effects complete {
      Read<AttestationBundle>
      Read<PullRequestBody>
      Update<PullRequestBody>
    }
}

component ShapeAttestationValidator {
  grants Append<AttestationObligations>
  grants Append<SemanticDiagnostics>
  grants Read<AttestationBundle>
  grants Read<GitTransition>
  grants Read<SemanticDiagnostics>
  fn applyAttestations
    source ts("packages/shp-checker/src/attestations.ts#applyAttestations")
    description "Validates the complete versioned bundle and exact base/head before satisfying only matching coverage obligations. Never waives parser, binding, conformance or final-forbid errors."
    effects complete {
      Append<AttestationObligations>
      Append<SemanticDiagnostics>
      Read<AttestationBundle>
      Read<GitTransition>
      Read<SemanticDiagnostics>
    }
}

component ShapeTransitionInput {
  grants Append<ChangedFileList>
  grants Read<GitTransition>
  fn requireCandidateFiles
    source ts("packages/shp-cli/src/check-input.ts#requireCandidateFiles")
    description "Rejects untracked or symlinked candidate inputs and requires default discovery to include every tracked non-hidden shape/**/*.shape path, including paths omitted by sparse checkout. Explicit file selection retains its selected scope."
    effects complete {
      Read<GitTransition>
        evidence ts("packages/shp-cli/src/check-input.ts#requireCandidateFiles")
    }
  fn resolveCheckTransition
    source ts("packages/shp-cli/src/check-input.ts#resolveCheckTransition")
    description "Resolves exact commits, rejects dirty candidates and checkout mismatches, and derives changed paths with NUL-delimited Git output."
    effects complete {
      Append<ChangedFileList>
      Read<GitTransition>
    }
}

relation CheckerValidatesExternalAttestations {
  kind calls
  connects ShapeChecker -> ShapeAttestationValidator
}

relation CliResolvesTransition {
  kind calls
  connects ShpCli -> ShapeTransitionInput
}

relation LiveCanaryExercisesPrEvidence {
  kind calls
  connects JevLiveCanary -> PullRequestEvidenceWorkflow
}

relation LiveCanaryExercisesSemanticReview {
  kind calls
  connects JevLiveCanary -> JevEnforcementSkill
}

relation PrWorkflowChecksShape {
  kind calls
  connects PullRequestEvidenceWorkflow -> ShapeChecker
}

relation PrWorkflowRequestsSemanticReview {
  kind calls
  connects PullRequestEvidenceWorkflow -> JevEnforcementSkill
}

relation PrWorkflowValidatesEvidence {
  kind calls
  connects PullRequestEvidenceWorkflow -> ShapeAttestationValidator
}

relation SemanticWorkflowAssemblesEvidence {
  kind calls
  connects JevEnforcementSkill -> JevEvidenceAssembler
}

reevaluation ExternalEvidencePipelineOrder {
  satisfies memory SharedCheckPipelineOrder
  outcome Confirmed
  summary "All deterministic checks still run before typed external evidence is validated. Only explicit missing-shape-update diagnostics can be satisfied; parser, final forbids and binding errors remain fatal."
  reviewer ShapeMaintainers
  decided_on "2026-09-21"
  evidence test("packages/shp-checker/src/attestations.test.ts")
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/model.ts")
  reason "Shared type declarations now describe the attestation validator and obligations modeled in shape.enforcement; they introduce no additional behavior beyond those claims."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/diagnostics.ts")
  reason "Formats evidence error codes without changing the existing diagnostic-rendering architecture."
}

attest no_shape_change {
  source ts("packages/shp-cli/src/check-runner.ts")
  reason "The existing runner connects the modeled ShapeTransitionInput candidate validation to the checker and renders its result; no additional boundary is introduced."
}

attest no_shape_change {
  source ts("packages/shp-cli/src/commands/check/command.ts")
  reason "Declares flags for the modeled ShapeTransitionInput and external attestation validation."
}

attest no_shape_change {
  source ts("packages/shp-cli/src/commands/check/impl.ts")
  reason "Connects the modeled transition input, attestation provider and checker without adding another architecture boundary."
}

attest no_shape_change {
  source md("plugins/shapelang/skills/shape-lang/SKILL.md")
  reason "Routes to the modeled PR and Jev enforcement workflow."
}

attest no_shape_change {
  source md("plugins/shapelang/skills/shape-lang/references/pr-enforcement.md")
  reason "Documents the modeled transition, evidence and optional Jev boundaries."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/reference/cli.md")
  reason "Documents the modeled CLI transition and evidence inputs."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/concepts/model-updates-attestations.md")
  reason "Documents the modeled provider selection and temporal evidence semantics."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/learn/ci-workflow.md")
  reason "Documents the modeled deterministic and optional semantic CI paths."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/inside-shape/rule-evaluation.md")
  reason "Documents the existing semantic pipeline and the separately modeled external-attestation validator."
}

attest no_shape_change {
  source yaml("docs/examples/pr-enforcement.yml")
  reason "The reference workflow connects the modeled exact PR check and direct Jev semantic workflow; provider policy remains outside the checker."
