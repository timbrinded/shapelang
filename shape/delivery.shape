      Read<DocsContent>
        evidence md("docs-site/src/content/docs/reference/cli.md")
      Read<DocsContent>
        evidence md("docs-site/src/content/docs/reference/diagnostics.md")
      Read<DocsContent>
        evidence md("docs-site/src/content/docs/reference/glossary.md")
      Read<DocsContent>
