component ReleasePipeline {
  owns InstallScript
  owns ReleaseArtifact
  grants Read<InstallScript>
  grants Read<NativeParserAsset>
  grants Read<ReleaseArtifact>
  grants Update<ReleaseArtifact>
  fn buildReleaseAssets : RefactorSensitive
    source sh("scripts/build-release-assets.sh")
    effects complete {
      Read<InstallScript>
        evidence sh("scripts/build-release-assets.sh")
      Read<InstallScript>
        evidence sh("install.sh")
      Read<InstallScript>
        evidence ps1("install.ps1")
      Read<NativeParserAsset>
        evidence sh("scripts/build-release-assets.sh")
      Read<NativeParserAsset>
        evidence ts("packages/shp-checker/src/tree-sitter-native-targets.ts")
      Update<ReleaseArtifact>
        evidence sh("scripts/build-release-assets.sh")
    }
  fn selectInstallReleaseAsset
    source yaml("action.yml")
    effects complete {
      Read<InstallScript>
        evidence yaml("action.yml")
      Read<InstallScript>
        evidence sh("install.sh")
      Read<InstallScript>
        evidence ps1("install.ps1")
      Read<NativeParserAsset>
        evidence ts("packages/shp-checker/src/tree-sitter-native-targets.ts")
      Read<ReleaseArtifact>
        evidence yaml("action.yml")
      Read<ReleaseArtifact>
        evidence sh("install.sh")
      Read<ReleaseArtifact>
        evidence ps1("install.ps1")
    }
}

relation CiPipelineUsesShapeCi {
  kind calls
  connects CiPipeline -> ShpCli
  summary "ShapeCiCommand"
}

relation CiPipelineUsesShapeReview {
  kind calls
  connects CiPipeline -> ShpCli
  summary "ShapeContractReview"
}

relation DocsSiteUsesDocsVerifier {
  kind calls
  connects DocsSite -> DocsShapeBlockVerifier
  summary "DocsExamples"
}

relation DocsSiteUsesGrammar {
  kind calls
  connects DocsSite -> ShapeGrammar
  summary "SyntaxReference"
}

relation ReleasePipelineUsesCi {
  kind calls
  connects ReleasePipeline -> CiPipeline
  summary "ReleaseValidation"
}

relation ReleasePipelineUsesCli {
  kind calls
  connects ReleasePipeline -> ShpCli
  summary "ReleaseBinary"
}

implementation AnalyzerSource {
  paths {
    "packages/shp-checker/src/analyzer.ts"
  }
  conforms_to ShapeAnalyzer
  on_change require shape_update
}

implementation AstGenerationSource {
  paths {
    "packages/shp-checker/src/ast-generation-core.ts"
    "packages/shp-checker/src/ast-generation.ts"
    "packages/shp-checker/src/generated-ast-policy.ts"
    "packages/shp-checker/src/source-languages.ts"
    "packages/shp-checker/src/tree-sitter-native-targets.ts"
  }
  conforms_to ShapeAstGenerator
  on_change require shape_update
}

implementation AuthoringSource {
  paths {
    "packages/shp-checker/src/authoring.ts"
  }
  conforms_to ShapeAuthoring
  on_change require shape_update
}

implementation CheckerSource {
  paths {
    "packages/shp-checker/src/checker.ts"
  }
  conforms_to ShapeChecker
  on_change require shape_update
}

implementation CiScripts {
  paths {
    "scripts/generate-ast-shapes.sh"
    "scripts/generate-ast-shapes.ts"
    "scripts/write-changed-files.sh"
  }
  conforms_to CiPipeline
  on_change require shape_update
}

implementation CliSource {
  paths {
    "packages/shp-cli/src/app.ts"
    "packages/shp-cli/src/commands/**/*.ts"
    "packages/shp-cli/src/context.ts"
    "packages/shp-cli/src/errors.ts"
    "packages/shp-cli/src/index.ts"
    "packages/shp-cli/src/io.ts"
    "packages/shp-cli/src/parameters.ts"
    "packages/shp-cli/src/shape-files.ts"
    "packages/shp-cli/src/version.ts"
  }
  conforms_to ShpCli
  on_change require shape_update
}

implementation CopilotReviewSource {
  paths {
    ".github/prompts/**/*.md"
  }
  conforms_to CiPipeline
  on_change require shape_update
}

implementation DocsSource {
  paths {
    "docs-site/scripts/**/*.ts"
    "docs-site/src/content/docs/**/*.md"
  }
  conforms_to DocsSite
  on_change require shape_update
}

implementation EditorSource {
  paths {
    "packages/shp-checker/src/editor.ts"
  }
  conforms_to ShapeEditorServices
  on_change require shape_update
}

implementation FormatterSource {
  paths {
    "packages/shp-checker/src/formatter.ts"
  }
  conforms_to ShapeFormatter
  on_change require shape_update
}

implementation GrammarSource {
  paths {
    "packages/shp-checker/src/language/**/*.ts"
    "packages/shp-checker/src/language/shape.langium"
  }
  conforms_to ShapeGrammar
  on_change require shape_update
}

implementation ParserSource {
  paths {
    "packages/shp-checker/src/parser.ts"
  }
  conforms_to ShapeParser
  on_change require shape_update
}

implementation ReleaseSource {
  paths {
    "action.yml"
    "install.ps1"
    "install.sh"
    "scripts/build-release-assets.sh"
  }
  conforms_to ReleasePipeline
  on_change require shape_update
}

implementation SyntaxHighlighterSource {
  paths {
    "docs-site/src/syntax/**/*.mjs"
  }
  conforms_to ShapeGrammar
  on_change require shape_update
}

implementation WorkflowSource {
  paths {
    ".github/scripts/**/*.mjs"
    ".github/workflows/**/*.yml"
  }
  conforms_to CiPipeline
  on_change require shape_update
}

binding CliDocs {
  when_changed paths {
    "packages/shp-cli/src/app.ts"
    "packages/shp-cli/src/commands/**/*.ts"
    "packages/shp-cli/src/context.ts"
    "packages/shp-cli/src/errors.ts"
    "packages/shp-cli/src/index.ts"
    "packages/shp-cli/src/io.ts"
    "packages/shp-cli/src/parameters.ts"
    "packages/shp-cli/src/shape-files.ts"
    "packages/shp-cli/src/version.ts"
    "shape/tooling.shape"
  }
  require_changed paths {
    "README.md"
    "docs-site/src/content/docs/learn/ci-workflow.md"
    "docs-site/src/content/docs/reference/cli.md"
  }
  allow attest docs_not_needed
}

binding DocsVerifierDocs {
  when_changed paths {
    "docs-site/scripts/verify-shape-blocks.ts"
    "shape/language.shape"
  }
  require_changed paths {
    "docs-site/src/content/docs/inside-shape/langium-grammar.md"
    "docs-site/src/content/docs/reference/local-development.md"
  }
  allow attest docs_not_needed
}

binding GrammarDocs {
  when_changed paths {
    "docs-site/src/syntax/**/*.mjs"
    "packages/shp-checker/src/language/generated/**/*.ts"
    "packages/shp-checker/src/language/shape.langium"
    "shape/language.shape"
  }
  require_changed paths {
    "docs-site/src/content/docs/inside-shape/langium-grammar.md"
    "docs-site/src/content/docs/reference/language-syntax.md"
  }
  allow attest docs_not_needed
}

binding RuleEngineDocs {
  when_changed paths {
    "packages/shp-checker/src/checker.ts"
    "shape/checker.shape"
  }
  require_changed paths {
    "docs-site/src/content/docs/concepts/diagnostics-provenance.md"
    "docs-site/src/content/docs/concepts/model-updates-attestations.md"
    "docs-site/src/content/docs/inside-shape/rule-evaluation.md"
    "docs-site/src/content/docs/reference/diagnostics.md"
  }
  allow attest docs_not_needed
}

binding ToolingDocs {
  when_changed paths {
    "packages/shp-checker/src/analyzer.ts"
    "packages/shp-checker/src/ast-generation-core.ts"
    "packages/shp-checker/src/ast-generation.ts"
    "packages/shp-checker/src/authoring.ts"
    "packages/shp-checker/src/editor.ts"
    "packages/shp-checker/src/formatter.ts"
    "packages/shp-checker/src/generated-ast-policy.ts"
    "packages/shp-checker/src/source-languages.ts"
    "packages/shp-checker/src/tree-sitter-native-targets.ts"
    "shape/tooling.shape"
  }
  require_changed paths {
    "docs-site/src/content/docs/concepts/analyzer-hints.md"
    "docs-site/src/content/docs/concepts/ast-generation.md"
    "docs-site/src/content/docs/inside-shape/formatter-editor-authoring.md"
    "docs-site/src/content/docs/reference/cli.md"
  }
  allow attest docs_not_needed
}

memory ReleaseChecksumContract : RefactorConstraint<fn ReleasePipeline.buildReleaseAssets> {
  applies_to fn ReleasePipeline.buildReleaseAssets
  status Explained
  confidence High
  summary "Release archives, installer templates, and checksums must stay in sync for binary installation."
  owner ShapeMaintainers
  protects shape ReleaseIntegrity
  guards on_change require ReEvaluation<Self>
}

memory ReleaseVersionTagContract : RefactorConstraint<fn CiPipeline.checkReleaseVersion> {
  applies_to fn CiPipeline.checkReleaseVersion
  status Explained
  confidence High
  summary "Release tags must match the CLI package manifest version before release assets are published."
  owner ShapeMaintainers
  protects shape ReleaseVersionIntegrity
  guards on_change require ReEvaluation<Self>
}

reevaluation DocsShapeBlockVerificationRechecked {
  satisfies memory DocsShapeBlockParsingContract
  outcome Confirmed
  summary "Docs verification still parses complete shape fences while file extension handling uses Node path semantics."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("docs-site/scripts/verify-shape-blocks.ts")
}

reevaluation ReleaseNativeParserAssetsRechecked {
  satisfies memory ReleaseChecksumContract
  outcome Confirmed
  summary "Release asset builds and installers read the shared native parser target matrix, reject unsupported platform archives such as macOS x64, compile matching bindings into advertised binaries, and still publish checksummed archives."
  reviewer ShapeMaintainers
  decided_on "2026-05-22"
  evidence sh("scripts/build-release-assets.sh")
}

reevaluation ReleaseVersionTagCheckRechecked {
  satisfies memory ReleaseVersionTagContract
  outcome Confirmed
  summary "The release workflow rejects tags that do not match packages/shp-cli/package.json."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence yaml(".github/workflows/release.yml")
}

attest no_shape_change {
  source md("docs-site/src/content/docs/concepts/rules-dependency-graphs.md")
  reason "Dependency graph docs were replaced by hypercycle docs in the hypergraph redesign."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/concepts/change-files-attestations.md")
  reason "Legacy change-file docs were renamed and replaced by global model update documentation."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/examples/authoring-pr-delta.md")
  reason "Legacy PR delta example was renamed and replaced by global model update documentation."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/examples/missing-shape-delta.md")
  reason "Legacy example page was renamed to missing-shape-update; the deleted path is intentionally obsolete."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/learn/pr-change-files.md")
  reason "Legacy PR change-file guide was renamed and replaced by global model update documentation."
}
