memory ReleaseChecksumContract : RefactorConstraint<fn ReleasePipeline.buildReleaseAssets> {
  applies_to fn ReleasePipeline.buildReleaseAssets
  status Explained
  confidence High
  summary "Release archives, bundled parser assets, installer templates, and checksums must stay in sync for binary installation."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ReleaseIntegrity
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ReleaseVersionTagContract : RefactorConstraint<fn CiPipeline.checkReleaseVersion> {
  applies_to fn CiPipeline.checkReleaseVersion
  status Explained
  confidence High
  summary "Release tags must match the CLI package manifest version before release assets are published."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ReleaseVersionIntegrity
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

reevaluation DocsShapeBlockVerificationRechecked {
  satisfies memory DocsShapeBlockParsingContract
  outcome Confirmed
  summary "Docs verification still parses complete shape fences while file extension handling uses Node path semantics."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("docs-site/scripts/verify-shape-blocks.ts")
}

reevaluation ReleaseNativeParserAssetsRechecked {
  satisfies memory ReleaseChecksumContract
  outcome Confirmed
  summary "Release asset builds include native bindings and verified parser libraries for every advertised source language, and installers stage parser assets with the executable before swapping them into place."
  reviewer ShapeMaintainers
  decided_on "2026-05-28"
  evidence ps1("install.ps1")
  evidence sh("install.sh")
  evidence sh("scripts/build-release-assets.sh")
  evidence ts("scripts/prepare-tree-sitter-parser-assets.ts")
}

reevaluation ReleaseVersionTagCheckRechecked {
  satisfies memory ReleaseVersionTagContract
  outcome Confirmed
  summary "The release workflow rejects tags that do not match packages/shp-cli/package.json."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence yaml(".github/workflows/release.yml")
}

attest docs_not_needed {
  source ts("docs-site/scripts/verify-shape-blocks.ts")
  reason "The verifier refactor preserves observed behaviour and CLI output; the documented docs:check workflow and grammar reference describe no internal verifier structure that changed."
}

attest docs_not_needed {
  source ts("packages/shp-checker/src/checker/rules.ts")
  reason "The rule-engine change only threads normalized options through the existing coverage rule; rule evaluation docs need no update."
}

attest docs_not_needed {
  source ts("packages/shp-checker/src/checker/rules/coverage.ts")
  reason "Repo-root injection is an embedding/testability boundary change; documented coverage and binding behavior is unchanged."
}

attest docs_not_needed {
  source shape("shape/tooling.shape")
  reason "The CLI runner helper is now explicitly modeled for governance; user-facing CLI commands, flags, and docs-visible behavior are unchanged."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/generated-ast-policy.ts")
  reason "Generated AST manifest helper cleanup is covered by the checker origin model update; the remaining manifest schema and path helper contract is unchanged."
}

attest no_shape_change {
  source ts("docs-site/scripts/verify-shape-blocks.test.ts")
  reason "Behavioural self-tests for the docs fence verifier (#64). Test-only code with no architectural surface of its own; it exercises the existing DocsShapeBlockVerifier contract rather than changing it."
}

attest no_shape_change {
  source md("docs-site/src/content/docs/concepts/unknowns-safety.md")
  reason "Migrated one memory-guard example from the removed flat member syntax to the canonical grouped blocks; the page's uncertainty/unknowns guidance and architectural surface are unchanged."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/editor.ts")
  reason "Definition lookup and completions now share add-entry symbol discovery, but ShapeEditorServices retains the same editor-output, source-read, parsed-module, and prelude-read contracts."
}

attest no_shape_change {
