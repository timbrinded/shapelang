module shape.delivery

import shape.checker

import shape.language

import shape.tooling

resource CiWorkflow

resource CliPackageManifest

resource CopilotReviewPrompt

resource CopilotReviewResult

resource DocsContent

resource InstallScript

resource NativeParserAsset

resource ReleaseArtifact

resource ReleaseVersionTag

component CiPipeline {
  owns CiWorkflow
  owns CopilotReviewPrompt
  owns CopilotReviewResult
  grants Read<ChangedFileList>
  grants Read<CiWorkflow>
  grants Read<CliPackageManifest>
  grants Read<CopilotReviewPrompt>
  grants Read<CopilotReviewResult>
  grants Read<GeneratedAstManifest>
  grants Read<LanguageSource>
  grants Read<ReleaseArtifact>
  grants Read<ReleaseVersionTag>
  grants Read<SemanticDiagnostics>
  grants Read<ShapeModelDraft>
  grants Read<ShapeSource>
  grants Read<SourceSyntaxTree>
  grants Update<ChangedFileList>
  grants Update<CopilotReviewResult>
  grants Update<GeneratedAstManifest>
  grants Update<ShapeModelDraft>
  fn checkReleaseVersion : RefactorSensitive
    source yaml(".github/workflows/release.yml#Check release tag matches CLI package version")
    effects complete {
      Read<CiWorkflow>
        evidence yaml(".github/workflows/release.yml")
      Read<CliPackageManifest>
        evidence json("packages/shp-cli/package.json")
      Read<ReleaseVersionTag>
        evidence yaml(".github/workflows/release.yml")
    }
  fn generateAstContext
    source ts("scripts/generate-ast-shapes.ts")
    effects complete {
      Read<CiWorkflow>
        evidence yaml(".github/workflows/shape.yml")
      Read<CiWorkflow>
        evidence yaml(".github/workflows/release.yml")
      Read<CliPackageManifest>
        evidence json("package.json")
      Read<GeneratedAstManifest>
        evidence json("shape/generated/ast/manifest.json")
      Read<LanguageSource>
        evidence ts("scripts/generate-ast-shapes.ts")
      Read<LanguageSource>
        evidence sh("scripts/generate-ast-shapes.sh")
      Read<SourceSyntaxTree>
        evidence ts("scripts/generate-ast-shapes.ts")
      Update<GeneratedAstManifest>
        evidence ts("scripts/generate-ast-shapes.ts")
      Update<ShapeModelDraft>
        evidence ts("scripts/generate-ast-shapes.ts")
    }
  fn runShapeCi
    source yaml(".github/workflows/shape.yml")
    effects complete {
      Read<ChangedFileList>
        evidence yaml(".github/workflows/shape.yml")
      Read<CiWorkflow>
        evidence yaml(".github/workflows/shape.yml")
      Read<CiWorkflow>
        evidence yaml(".github/workflows/release.yml")
      Read<SemanticDiagnostics>
        evidence yaml(".github/workflows/shape.yml")
    }
  fn runShapeContractReview
    source yaml(".github/workflows/shape.yml")
    effects complete {
      Read<ChangedFileList>
        evidence yaml(".github/workflows/shape.yml")
      Read<CiWorkflow>
        evidence yaml(".github/workflows/shape.yml")
      Read<CopilotReviewPrompt>
        evidence md(".github/prompts/shape-contract-review.md")
      Read<CopilotReviewResult>
        evidence mjs(".github/scripts/check-copilot-shape-review.mjs")
      Read<SemanticDiagnostics>
        evidence yaml(".github/workflows/shape.yml")
      Update<CopilotReviewResult>
        evidence mjs(".github/scripts/check-copilot-shape-review.mjs")
    }
  fn smokeReleaseBinary
    source yaml(".github/workflows/release.yml#Smoke test release binary")
    effects complete {
      Read<CiWorkflow>
        evidence yaml(".github/workflows/release.yml")
      Read<CiWorkflow>
        evidence yaml(".github/workflows/shape.yml")
      Read<LanguageSource>
        evidence yaml(".github/workflows/release.yml")
      Read<LanguageSource>
        evidence yaml(".github/workflows/shape.yml")
      Read<ReleaseArtifact>
        evidence yaml(".github/workflows/release.yml")
      Read<ReleaseArtifact>
        evidence yaml(".github/workflows/shape.yml")
      Read<SemanticDiagnostics>
        evidence yaml(".github/workflows/release.yml")
      Read<SemanticDiagnostics>
        evidence yaml(".github/workflows/shape.yml")
      Read<ShapeModelDraft>
        evidence yaml(".github/workflows/release.yml")
      Read<ShapeModelDraft>
        evidence yaml(".github/workflows/shape.yml")
      Read<SourceSyntaxTree>
        evidence yaml(".github/workflows/release.yml")
      Read<SourceSyntaxTree>
        evidence yaml(".github/workflows/shape.yml")
    }
  fn writeChangedFiles
    source sh("scripts/write-changed-files.sh")
    effects complete {
      Update<ChangedFileList>
        evidence sh("scripts/write-changed-files.sh")
    }
}

