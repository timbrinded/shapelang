      Read<CiWorkflow>
        evidence yaml(".github/workflows/release-candidate.yml")
      Read<SkillReleaseReport>
        evidence yaml(".github/workflows/release-candidate.yml")
      Update<SkillReleaseApproval>
        evidence yaml(".github/workflows/release-candidate.yml")
    }
