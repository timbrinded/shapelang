memory ReleaseChecksumContract : RefactorConstraint<fn ReleasePipeline.buildReleaseAssets> {
  applies_to fn ReleasePipeline.buildReleaseAssets
  status Explained
  confidence High
  summary "Release archives, bundled parser assets, installer templates, and checksums must stay in sync for binary installation."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ReleaseIntegrity
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ReleaseVersionTagContract : RefactorConstraint<fn CiPipeline.checkReleaseVersion> {
  applies_to fn CiPipeline.checkReleaseVersion
  status Explained
  confidence High
  summary "Release tags, the CLI package, both plugin manifests, authored notes, and current public version pins must share one version before approved release assets are published."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ReleaseVersionIntegrity
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory SkillsApprovalReuseContract : RefactorConstraint<fn CiPipeline.reuseReleaseSkillsEvaluation> {
  applies_to fn CiPipeline.reuseReleaseSkillsEvaluation
  status Explained
  confidence High
  summary "A skills report may be copied from this SHA's approved run, or from an ancestor when git diff --name-only --no-renames has no path under SKILLS_RELEVANT_PATH_PREFIXES. Publishing still requires an approved candidate run on the exact tag SHA."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape SkillsApprovalReuse
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

reevaluation DocsShapeBlockVerificationRechecked {
  satisfies memory DocsShapeBlockParsingContract
  outcome Confirmed
  summary "Docs verification still parses complete shape fences while file extension handling uses Node path semantics."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("docs-site/scripts/verify-shape-blocks.ts")
}

reevaluation ReleaseDistributionVersionsRechecked {
  satisfies memory ReleaseVersionTagContract
  outcome Confirmed
  summary "The shared metadata validator rejects a release unless the tag, CLI package, and both plugin manifests agree."
  reviewer ShapeMaintainers
  decided_on "2026-07-28"
  evidence test("scripts/check-release-metadata.test.ts")
  evidence ts("scripts/check-release-metadata.ts#validateReleaseMetadata")
  evidence yaml(".github/workflows/release.yml")
}

reevaluation ReleaseNativeParserAssetsRechecked {
  satisfies memory ReleaseChecksumContract
  outcome Confirmed
  summary "Release asset builds include native bindings and verified parser libraries for every advertised source language, and installers stage parser assets with the executable before swapping them into place."
  reviewer ShapeMaintainers
  decided_on "2026-05-28"
  evidence ps1("install.ps1")
  evidence sh("install.sh")
  evidence sh("scripts/build-release-assets.sh")
  evidence ts("scripts/prepare-tree-sitter-parser-assets.ts")
}

reevaluation ReleaseNotesVersionRechecked {
  satisfies memory ReleaseVersionTagContract
  outcome Confirmed
  summary "The shared metadata validator still requires the tag, CLI package, both plugin manifests, and authored release notes to share one X.Y.Z."
  reviewer ShapeMaintainers
  decided_on "2026-09-07"
  evidence md("docs/releases/v0.9.0.md")
  evidence test("scripts/check-release-metadata.test.ts")
  evidence ts("scripts/check-release-metadata.ts#validateReleaseMetadata")
}

reevaluation ReleaseVersionPinsRechecked {
  satisfies memory ReleaseVersionTagContract
  outcome Confirmed
  summary "Metadata validation still requires one X.Y.Z and now also requires each listed pin file to contain the current-version snippet."
  reviewer ShapeMaintainers
  decided_on "2026-09-07"
  evidence md(".github/prompts/shape-skills-release.md")
  evidence md("README.md")
  evidence test("scripts/check-release-metadata.test.ts")
  evidence ts("scripts/check-release-metadata.ts#missingReleasePins")
}

reevaluation ReleaseVersionTagCheckRechecked {
  satisfies memory ReleaseVersionTagContract
  outcome Confirmed
  summary "The release workflow rejects tags that do not match packages/shp-cli/package.json."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence yaml(".github/workflows/release.yml")
}

reevaluation SkillsApprovalReuseIntroduced {
  satisfies memory SkillsApprovalReuseContract
  outcome Confirmed
  summary "A skills report may be copied from this SHA's approved run, or from an ancestor when git diff --name-only --no-renames has no path under SKILLS_RELEVANT_PATH_PREFIXES. Validate, archive smoke, and skills-release-approval still run on this commit. Publishing still requires an approved candidate on the exact tag SHA."
  reviewer ShapeMaintainers
  decided_on "2026-09-07"
  evidence mjs(".github/scripts/run-claude-skill.mjs#releasePrefilter")
  evidence test("scripts/check-release-approval.test.ts")
  evidence ts("scripts/check-release-approval.ts#findReusableSkillsReport")
  evidence yaml(".github/workflows/release-candidate.yml")
}

reevaluation SkillsRelevantRenameInvalidatesReuse {
  satisfies memory SkillsApprovalReuseContract
  outcome Confirmed
  summary "git diff --name-only --no-renames lists both sides of a move, so a file under SKILLS_RELEVANT_PATH_PREFIXES renamed out of that list still blocks copying an ancestor report."
  reviewer ShapeMaintainers
  decided_on "2026-09-07"
  evidence test("scripts/check-release-approval.test.ts")
  evidence ts("scripts/check-release-approval.ts#findReusableSkillsReport")
}

reevaluation SkillsReportCopyNamed {
  satisfies memory SkillsApprovalReuseContract
  outcome Confirmed
  summary "The lookup is findReusableSkillsReport. It copies a report for this SHA or an ancestor. Validate, archive smoke, and skills-release-approval still run on this commit."
  reviewer ShapeMaintainers
  decided_on "2026-09-07"
  evidence test("scripts/check-release-approval.test.ts")
  evidence ts("scripts/check-release-approval.ts#findReusableSkillsReport")
}

attest no_shape_change {
  source sh("scripts/write-changed-files.sh")
  reason "The pull-request base branch is fetched without --depth=1 so the full-history checkout is never grafted; the written changed-file list and the modeled ChangedFileList effect are unchanged."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/model.ts")
  reason "Adds the invalid_implementation variant to the SemanticDiagnostic union; the lowering and formatter behaviour that uses it is modelled in ShapeModelLowerer.lowerImplementation."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/model.ts")
  reason "Adds the baseModules check option and the stale_attestation diagnostic variant; the base comparison they carry is modelled by BaseShapeModel reads on checkCoverage, checkBindings, and checkStaleAttestations."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/rules.ts")
  reason "Registers checkStaleAttestations after coverage in the ordered semantic-check list and threads the base attestation keys into checkCoverage; both rules are modelled on ShapeRuleEngine."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/model.ts")
  reason "Replaces the base attestation-key option with a BaseModel carrying keys and per-file attestation-free text, and records each input file's text on Model.attestationFreeTexts by file path; the binding behaviour it enables is modelled on ShapeBindings.checkBindings."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/rules.ts")
  reason "Passes the BaseModel option to checkCoverage and checkStaleAttestations; rule order and the enabled checks are unchanged."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/model.ts")
  reason "Adds the repositoryFiles check option and the missing_cited_path diagnostic variant; the rule that uses them is modelled as ShapeRuleEngine.checkCitedPaths."
}

attest no_shape_change {
  source ts("packages/shp-checker/src/checker/rules.ts")
  reason "Registers checkCitedPaths last in the ordered semantic-check list, gated on the repositoryFiles option; the earlier checks and their order are unchanged."
}
