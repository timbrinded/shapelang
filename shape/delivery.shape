component ReleasePipeline {
  owns InstallScript
  owns ReleaseArtifact
  grants Read<InstallScript>
  grants Read<NativeParserAsset>
  grants Read<ReleaseArtifact>
  grants Update<ReleaseArtifact>
  fn buildReleaseAssets : RefactorSensitive
    source sh("scripts/build-release-assets.sh")
    effects complete {
      Read<InstallScript>
        evidence sh("scripts/build-release-assets.sh")
      Read<InstallScript>
        evidence sh("install.sh")
      Read<InstallScript>
        evidence ps1("install.ps1")
      Read<NativeParserAsset>
        evidence sh("scripts/build-release-assets.sh")
      Read<NativeParserAsset>
        evidence ts("scripts/prepare-tree-sitter-parser-assets.ts")
      Read<NativeParserAsset>
        evidence ts("packages/shp-checker/src/tree-sitter-native-targets.ts")
      Update<ReleaseArtifact>
        evidence sh("scripts/build-release-assets.sh")
    }
  fn selectInstallReleaseAsset
    source yaml("action.yml")
    effects complete {
      Read<InstallScript>
        evidence yaml("action.yml")
      Read<InstallScript>
        evidence sh("install.sh")
      Read<InstallScript>
        evidence ps1("install.ps1")
      Read<NativeParserAsset>
        evidence ts("packages/shp-checker/src/tree-sitter-native-targets.ts")
      Read<ReleaseArtifact>
        evidence yaml("action.yml")
      Read<ReleaseArtifact>
        evidence sh("install.sh")
      Read<ReleaseArtifact>
        evidence ps1("install.ps1")
    }
  fn smokeReleaseBinary
    source sh("scripts/smoke-release-binary.sh")
    description "Extracts a release archive and runs version, help, check, and AST. Without --quick it also runs graph, draft/strict, author, analyzer, and domain-pack checks. Candidate native runners pass --quick; Linux x64 and the post-tag rebuild run the full script."
    effects complete {
      Read<ReleaseArtifact>
        evidence sh("scripts/smoke-release-binary.sh")
    }
}

