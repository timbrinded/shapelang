relation ShapeBindingsReadLoweredFacts {
  kind calls
  connects ShapeBindings -> ShapeModelLowerer
  summary "BindingFacts"
}

relation ShapeBindingsUsesStringHelpers {
  kind calls
  connects ShapeBindings -> ShapeStringHelpers
  summary "BindingPathNormalization"
}

relation ShapeCheckerProvidesConformance {
  kind provides
  connects ShapeChecker -> ShapeConformance
}

relation ShapeCheckerUsesBindings {
  kind calls
  connects ShapeChecker -> ShapeBindings
  summary "BindingRules"
}

relation ShapeCheckerUsesDiagnostics {
  kind calls
  connects ShapeChecker -> ShapeDiagnostics
  summary "CanonicalDiagnosticOrdering"
}

relation ShapeCheckerUsesModelPipeline {
  kind calls
  connects ShapeChecker -> ShapeModelLowerer
  summary "ModelPipeline"
}

relation ShapeCheckerUsesRulePipeline {
  kind calls
  connects ShapeChecker -> ShapeRuleEngine
  summary "RulePipeline"
}

relation ShapeCheckerUsesStringHelpers {
  kind calls
  connects ShapeChecker -> ShapeStringHelpers
  summary "CanonicalFactOrdering"
}

relation ShapeDiagnosticsProvidesText {
  kind provides
  connects ShapeDiagnostics -> HumanReadableDiagnostics
}

relation ShapeDiagnosticsReadsRuleOutput {
  kind calls
  connects ShapeDiagnostics -> ShapeRuleEngine
  summary "DiagnosticInput"
}

relation ShapeModelLowererProvidesEffectiveModel {
  kind provides
  connects ShapeModelLowerer -> EffectiveShapeModel
}

relation ShapeModelLowererProvidesFacts {
  kind provides
  connects ShapeModelLowerer -> ShapeFacts
}

relation ShapeModelLowererUsesParser {
  kind calls
  connects ShapeModelLowerer -> ShapeParser
  summary "ParsedInput"
}

relation ShapeModelLowererUsesPreludeRegistry {
  kind calls
  connects ShapeModelLowerer -> ShapePreludeRegistry
  summary "PreludeFacts"
}

relation ShapeModelLowererUsesStringHelpers {
  kind calls
  connects ShapeModelLowerer -> ShapeStringHelpers
  summary "SourceReferenceNormalization"
}

relation ShapePreludeRegistryProvidesMetadata {
  kind provides
  connects ShapePreludeRegistry -> PreludeMetadata
}

relation ShapeRuleEngineProvidesDiagnostics {
  kind provides
  connects ShapeRuleEngine -> SemanticDiagnosticSet
}

relation ShapeRuleEngineReadsLoweredFacts {
  kind calls
  connects ShapeRuleEngine -> ShapeModelLowerer
  summary "LoweredFacts"
}

relation ShapeRuleEngineUsesPreludeRegistry {
  kind calls
  connects ShapeRuleEngine -> ShapePreludeRegistry
  summary "PreludeRules"
}

relation ShapeRuleEngineUsesStringHelpers {
  kind calls
  connects ShapeRuleEngine -> ShapeStringHelpers
  summary "CoveragePathNormalization"
}

relation ShapeStringHelpersProvideReferences {
  kind provides
  connects ShapeStringHelpers -> NormalizedShapeReference
}

rule checker_contract_providers {
  forbid provides EffectiveShapeModel except ShapeModelLowerer
  forbid provides HumanReadableDiagnostics except ShapeDiagnostics
  forbid provides NormalizedShapeReference except ShapeStringHelpers
  forbid provides PreludeMetadata except ShapePreludeRegistry
  forbid provides SemanticDiagnosticSet except ShapeRuleEngine
  forbid provides ShapeConformance except ShapeChecker
  forbid provides ShapeFacts except ShapeModelLowerer
}

rule no_runtime_dependency_cycles {
  forbid hypercycle over calls
}

memory BindingDocsCouplingContract : RefactorConstraint<fn ShapeBindings.checkBindings> {
  applies_to fn ShapeBindings.checkBindings
  status Explained
  confidence High
  summary "Bindings enforce review coupling and compare current attestations with normalized repo-relative changed-file paths."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape DocsCoupling
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory CheckPipelineOrder : CheckOrderRationale<fn ShapeChecker.checkShapeModules> {
  applies_to fn ShapeChecker.checkShapeModules
  status Explained
  confidence High
  summary "The checker must lower the effective model before semantic rules and coverage/binding checks run."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape PhaseOrder
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory CoverageCurrentUpdateContract : RefactorConstraint<fn ShapeRuleEngine.checkCoverage> {
  applies_to fn ShapeRuleEngine.checkCoverage
  status Explained
  confidence High
  summary "Coverage accepts a source or attestation only when the declaring Shape file matches the current changed-file input after path normalization."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape CurrentChangeCoverage
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory DiagnosticContract : RefactorConstraint<fn ShapeDiagnostics.formatDiagnostics> {
  applies_to fn ShapeDiagnostics.formatDiagnostics
  status Explained
  confidence High
  summary "Diagnostics are a product surface and must keep causal paths understandable for reviewers."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape DiagnosticOutput
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory FinalForbidPrecedence : RefactorConstraint<fn ShapeRuleEngine.deriveFinalForbidsForResource> {
  applies_to fn ShapeRuleEngine.deriveFinalForbidsForResource
  status Explained
  confidence High
  summary "Final forbids must remain stronger than component grants, resolve concrete targets deterministically, and cannot be waived by rationale or memory."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape FinalForbidPrecedence
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ForbiddenPathWitness : RefactorConstraint<fn ShapeRuleEngine.findShortestPath> {
  applies_to fn ShapeRuleEngine.findShortestPath
  status Explained
  confidence High
  summary "Forbidden path diagnostics must choose a deterministic fewest-hop directed witness and preserve relation kind, name, and provenance for every hop."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ForbiddenPathWitness
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory FreshnessDeterminism : RefactorConstraint<fn ShapeRuleEngine.checkFreshness> {
  applies_to fn ShapeRuleEngine.checkFreshness
  status Explained
  confidence High
  summary "Freshness compares review_by against a caller-injected ISO date, never the system clock, and enforces only ISO YYYY-MM-DD values so checks stay deterministic."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape DeterministicFreshness
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory GuardedChangePrecision : RefactorConstraint<fn ShapeRuleEngine.checkGuardedChanges> {
  applies_to fn ShapeRuleEngine.checkGuardedChanges
  status Explained
  confidence High
  summary "Guards fire property-level when every protected property is detectable (a named shape trait or the description), forbid-transform guards fire when a change declares the matching transform intent, and function, component, resource, and relation targets otherwise fall back to coarse modify/remove matching, so existing coarse guards keep their behaviour and final forbids are never waived."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape GuardedChangePrecision
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory HypercycleWitness : RefactorConstraint<fn ShapeRuleEngine.findHypercycle> {
  applies_to fn ShapeRuleEngine.findHypercycle
  status Explained
  confidence High
  summary "Hypercycle diagnostics need a deterministic shortest witness path so reviewers can understand the tightest rejected structural relation."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape HypercycleWitness
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory LoweringBeforeRules : CheckOrderRationale<fn ShapeModelLowerer.lowerShapeModules> {
  applies_to fn ShapeModelLowerer.lowerShapeModules
  status Explained
  confidence High
  summary "Module-scoped declarations, concrete forbid targets, generated candidate evidence, and change declarations must be resolved into the final effective model before derived facts are emitted."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape EffectiveModelOrder
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory PreludeMetadataContract : RefactorConstraint<fn ShapePreludeRegistry.definePreludeMetadata> {
  applies_to fn ShapePreludeRegistry.definePreludeMetadata
  status Explained
  confidence High
  summary "Prelude traits, relation kinds, and context requirements are semantic inputs shared by checker, editor, and authoring surfaces; context requirements derive obligations for function, component, and resource targets, and are merged with user-defined trait require_context obligations during checking."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape PreludeConsistency
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ReevaluationPolicyContract : RefactorConstraint<fn ShapeRuleEngine.checkReevaluations> {
  applies_to fn ShapeRuleEngine.checkReevaluations
  status Explained
  confidence High
  summary "Reevaluation validation requires structural fields plus an approver when a project policy requires one for a sensitive memory, and validates reviewer/approver against declared roles; approver and role checks stay opt-in so the default reviewer-only path is preserved."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape ReevaluationValidation
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ShapeSourceNormalizationContract : RefactorConstraint<fn ShapeStringHelpers.normalizeShapeSourcePath> {
  applies_to fn ShapeStringHelpers.normalizeShapeSourcePath
  status Explained
  confidence High
  summary "Source-reference normalization must keep coverage, binding, and analyzer comparisons using the same repo-relative path rules."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape CurrentChangeCoverage
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

memory ShapeStringLiteralContract : RefactorConstraint<fn ShapeStringHelpers.unquoteShapeString> {
  applies_to fn ShapeStringHelpers.unquoteShapeString
  status Explained
  confidence High
  summary "Shape string literal unquoting must stay consistent across lowering and formatting."
  who {
    owner ShapeMaintainers
  }
  protects {
    shape CanonicalFormatting
  }
  guards {
    on_change require ReEvaluation<Self>
  }
}

reevaluation BindingCurrentAttestationsRechecked {
  satisfies memory BindingDocsCouplingContract
  outcome Confirmed
  summary "Binding checks still use normalized current changed-file attestations after hoisting binding-wide work."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation CheckerPhaseOrderRechecked {
  satisfies memory CheckPipelineOrder
  outcome Confirmed
  summary "Checker dispatch still lowers the effective model before semantic and changed-file rules run."
