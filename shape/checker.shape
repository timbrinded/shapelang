module shape.checker

import shape.language

import shape.tooling

resource ChangedFileList

resource EffectiveModel

resource EffectiveShapeModel

resource FactSet

resource HumanReadableDiagnostics

resource ModuleNamespace

resource NormalizedShapeReference

resource PreludeMetadata

resource SemanticDiagnosticSet

resource SemanticDiagnostics

resource ShapeBinding

resource ShapeConformance

resource ShapeFacts

resource ShapeHypergraph

component ShapeBindings {
  owns ShapeBinding
  grants Append<SemanticDiagnostics>
  grants Read<ChangedFileList>
  grants Read<NormalizedShapeReference>
  grants Read<ShapeBinding>
  fn checkBindings : RefactorSensitive
    source ts("packages/shp-checker/src/checker/rules/coverage.ts#checkBindings")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
      Read<NormalizedShapeReference>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
      Read<ShapeBinding>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
    }
}

