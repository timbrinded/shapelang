reevaluation LoweringFunctionRegistryRechecked {
  satisfies memory LoweringBeforeRules
  outcome Confirmed
  summary "Function add, modify, and remove changes update component.functions before derived facts and coverage paths are emitted."
  reviewer ShapeMaintainers
  decided_on "2026-05-21"
  evidence test("packages/shp-checker/src/checker.test.ts")
