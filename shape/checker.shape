  summary "PreludeRules"
}

relation ShapeRuleEngineUsesStringHelpers {
  kind calls
  connects ShapeRuleEngine -> ShapeStringHelpers
  summary "CoveragePathNormalization"
}

relation ShapeStringHelpersProvideReferences {
  kind provides
  connects ShapeStringHelpers -> NormalizedShapeReference
}

rule checker_contract_providers {
  forbid provides EffectiveShapeModel except ShapeModelLowerer
  forbid provides HumanReadableDiagnostics except ShapeDiagnostics
  forbid provides MachineReadableShapeModel except ShapeChecker
  forbid provides NormalizedShapeReference except ShapeStringHelpers
  forbid provides PreludeMetadata except ShapePreludeRegistry
  forbid provides SemanticDiagnosticSet except ShapeRuleEngine
  forbid provides ShapeConformance except ShapeChecker
  forbid provides ShapeFacts except ShapeModelLowerer
}

rule no_runtime_dependency_cycles {
  forbid hypercycle over calls
}

memory AtomicChangePlanning : RefactorConstraint<fn ShapeModelLowerer.lowerChange> {
  applies_to fn ShapeModelLowerer.lowerChange
