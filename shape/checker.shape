component ShapeBindings {
  owns ShapeBinding
  grants Append<SemanticDiagnostics>
  grants Read<BaseShapeModel>
  grants Read<ChangedFileList>
  grants Read<EffectiveModel>
  grants Read<NormalizedShapeReference>
  grants Read<ShapeBinding>
  fn checkBindings : RefactorSensitive
    source ts("packages/shp-checker/src/checker/rules/coverage.ts#checkBindings")
    description "A .shape file whose attestation-free text matches its base version changed only in attestations and does not trigger bindings; the text is compared per file path, and a module without source text never matches."
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
      Read<BaseShapeModel>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts#isCurrentAttestation")
      Read<BaseShapeModel>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts#isAttestationOnlyChange")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
      Read<EffectiveModel>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts#isAttestationOnlyChange")
      Read<NormalizedShapeReference>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
      Read<ShapeBinding>
        evidence ts("packages/shp-checker/src/checker/rules/coverage.ts")
    }
}

