}

reevaluation FinalForbidPrecedenceRechecked {
  satisfies memory FinalForbidPrecedence
  outcome Confirmed
  summary "Final forbid derivation still reads prelude metadata and remains stronger than component grants."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/checker.test.ts")
