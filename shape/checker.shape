  decided_on "2026-05-21"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation DiagnosticOutputRechecked {
  satisfies memory DiagnosticContract
  outcome Confirmed
  summary "Diagnostic formatting remains path-aware and reviewer-readable after shared string handling changes."
