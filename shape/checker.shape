}

reevaluation FinalForbidPrecedenceRechecked {
  satisfies memory FinalForbidPrecedence
  outcome Confirmed
  summary "Final forbid derivation still reads prelude metadata, resolves concrete targets through module scope, rejects invalid rule binders, and remains stronger than component grants."
  reviewer ShapeMaintainers
  decided_on "2026-05-28"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation HypercycleTraversalRechecked {
  satisfies memory HypercycleWitness
  outcome Confirmed
  summary "The backtracking traversal preserves deterministic hypercycle witness diagnostics."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation LoweringFunctionRegistryRechecked {
  satisfies memory LoweringBeforeRules
  outcome Confirmed
  summary "Checker tests cover module-scoped import resolution with ambiguity rejection, concrete forbid target lowering, generated candidate effect validation, explicit generated AST module origin, and function registry rebuilds before derived facts and coverage paths are emitted."
  reviewer ShapeMaintainers
  decided_on "2026-05-28"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

