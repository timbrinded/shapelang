component ShapeStringHelpers {
  owns NormalizedShapeReference
  grants Read<ShapeSource>
  grants Update<NormalizedShapeReference>
  fn normalizeShapeSourcePath : RefactorSensitive
    source ts("packages/shp-checker/src/shape-strings.ts#normalizeShapeSourcePath")
    effects complete {
      Read<ShapeSource>
