module shape.checker

import shape.language

resource ChangedFileList

resource EffectiveModel

resource EffectiveShapeModel

resource FactSet

resource HumanReadableDiagnostics

resource SemanticDiagnostics

resource SemanticDiagnosticSet

resource ShapeBinding

resource ShapeConformance

resource ShapeFacts

resource ShapeHypergraph

component ShapeBindings {
  owns ShapeBinding
  grants Append<SemanticDiagnostics>
  grants Read<ChangedFileList>
  grants Read<ShapeBinding>
  fn checkBindings : RefactorSensitive
    source ts("packages/shp-checker/src/checker.ts#checkBindings")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ShapeBinding>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
}

component ShapeChecker {
  grants Append<SemanticDiagnostics>
  grants Read<ChangedFileList>
  grants Read<EffectiveModel>
  grants Read<FactSet>
  fn checkShapeFiles
    source ts("packages/shp-checker/src/checker.ts#checkShapeFiles")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
  fn checkShapeModules : ProtectedCheckOrder
    source ts("packages/shp-checker/src/checker.ts#checkShapeModules")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<EffectiveModel>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<FactSet>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
}

component ShapeDiagnostics {
  grants Append<DiagnosticText>
  grants Read<SemanticDiagnostics>
  fn formatDiagnostics : RefactorSensitive
    source ts("packages/shp-checker/src/checker.ts#formatDiagnostics")
    effects complete {
      Append<DiagnosticText>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
}

component ShapeModelLowerer {
  owns EffectiveModel
  owns FactSet
  grants Append<FactSet>
  grants Read<ParsedModule>
  grants Update<EffectiveModel>
  fn lowerShapeModules : ProtectedCheckOrder
    source ts("packages/shp-checker/src/checker.ts#lowerShapeModules")
    effects complete {
      Append<FactSet>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ParsedModule>
        evidence ts("packages/shp-checker/src/checker.ts")
      Update<EffectiveModel>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
}

component ShapeRuleEngine {
  owns SemanticDiagnostics
  owns ShapeHypergraph
  grants Append<SemanticDiagnostics>
  grants Read<ChangedFileList>
  grants Read<EffectiveModel>
  grants Read<FactSet>
  grants Update<ShapeHypergraph>
  fn checkCoverage : RefactorSensitive
    source ts("packages/shp-checker/src/checker.ts#checkCoverage")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<EffectiveModel>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
  fn deriveFinalForbidsForResource : RefactorSensitive
    source ts("packages/shp-checker/src/checker.ts#deriveFinalForbidsForResource")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<FactSet>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
  fn findHypercycle : RefactorSensitive
    source ts("packages/shp-checker/src/checker.ts#findHypercycle")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<EffectiveModel>
        evidence ts("packages/shp-checker/src/checker.ts")
      Update<ShapeHypergraph>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
}

relation ShapeBindingsReadLoweredFacts {
  kind calls
  connects ShapeBindings -> ShapeModelLowerer
  summary "BindingFacts"
}

relation ShapeCheckerProvidesConformance {
  kind provides
  connects ShapeChecker -> ShapeConformance
}

relation ShapeCheckerUsesBindings {
  kind calls
  connects ShapeChecker -> ShapeBindings
  summary "BindingRules"
}

relation ShapeCheckerUsesModelPipeline {
  kind calls
  connects ShapeChecker -> ShapeModelLowerer
  summary "ModelPipeline"
}

relation ShapeCheckerUsesRulePipeline {
  kind calls
  connects ShapeChecker -> ShapeRuleEngine
  summary "RulePipeline"
}

relation ShapeDiagnosticsProvidesText {
  kind provides
  connects ShapeDiagnostics -> HumanReadableDiagnostics
}

relation ShapeDiagnosticsReadsRuleOutput {
  kind calls
  connects ShapeDiagnostics -> ShapeRuleEngine
  summary "DiagnosticInput"
}

relation ShapeModelLowererProvidesEffectiveModel {
  kind provides
  connects ShapeModelLowerer -> EffectiveShapeModel
}

relation ShapeModelLowererProvidesFacts {
  kind provides
  connects ShapeModelLowerer -> ShapeFacts
}

relation ShapeModelLowererUsesParser {
  kind calls
  connects ShapeModelLowerer -> ShapeParser
  summary "ParsedInput"
}

relation ShapeRuleEngineProvidesDiagnostics {
  kind provides
  connects ShapeRuleEngine -> SemanticDiagnosticSet
}

relation ShapeRuleEngineReadsLoweredFacts {
  kind calls
  connects ShapeRuleEngine -> ShapeModelLowerer
  summary "LoweredFacts"
}

rule checker_contract_providers {
  forbid provides EffectiveShapeModel except ShapeModelLowerer
  forbid provides HumanReadableDiagnostics except ShapeDiagnostics
  forbid provides SemanticDiagnosticSet except ShapeRuleEngine
  forbid provides ShapeConformance except ShapeChecker
  forbid provides ShapeFacts except ShapeModelLowerer
}

rule no_runtime_dependency_cycles {
  forbid hypercycle over calls
}

memory BindingDocsCouplingContract : RefactorConstraint<fn ShapeBindings.checkBindings> {
  applies_to fn ShapeBindings.checkBindings
  status Explained
  confidence High
  summary "Bindings enforce review coupling between Shape-affecting changes and documentation updates or narrow current-change docs_not_needed attestations."
  owner ShapeMaintainers
  protects shape DocsCoupling
  guards on_change require ReEvaluation<Self>
}

memory CheckPipelineOrder : CheckOrderRationale<fn ShapeChecker.checkShapeModules> {
  applies_to fn ShapeChecker.checkShapeModules
  status Explained
  confidence High
  summary "The checker must lower the effective model before semantic rules and coverage/binding checks run."
  owner ShapeMaintainers
  protects shape PhaseOrder
  guards on_change require ReEvaluation<Self>
}

memory CoverageCurrentDeltaContract : RefactorConstraint<fn ShapeRuleEngine.checkCoverage> {
  applies_to fn ShapeRuleEngine.checkCoverage
  status Explained
  confidence High
  summary "Coverage may accept a source or attestation waiver only when the declaring Shape file is part of the current changed-file input."
  owner ShapeMaintainers
  protects shape CurrentChangeCoverage
  guards on_change require ReEvaluation<Self>
}

memory DiagnosticContract : RefactorConstraint<fn ShapeDiagnostics.formatDiagnostics> {
  applies_to fn ShapeDiagnostics.formatDiagnostics
  status Explained
  confidence High
  summary "Diagnostics are a product surface and must keep causal paths understandable for reviewers."
  owner ShapeMaintainers
  protects shape DiagnosticOutput
  guards on_change require ReEvaluation<Self>
}

memory FinalForbidPrecedence : RefactorConstraint<fn ShapeRuleEngine.deriveFinalForbidsForResource> {
  applies_to fn ShapeRuleEngine.deriveFinalForbidsForResource
  status Explained
  confidence High
  summary "Final forbids must remain stronger than component grants and cannot be waived by rationale or memory."
  owner ShapeMaintainers
  protects shape FinalForbidPrecedence
  guards on_change require ReEvaluation<Self>
}

memory HypercycleWitness : RefactorConstraint<fn ShapeRuleEngine.findHypercycle> {
  applies_to fn ShapeRuleEngine.findHypercycle
  status Explained
  confidence High
  summary "Hypercycle diagnostics need a deterministic witness path so reviewers can understand the rejected structural relation."
  owner ShapeMaintainers
  protects shape HypercycleWitness
  guards on_change require ReEvaluation<Self>
}

memory LoweringBeforeRules : CheckOrderRationale<fn ShapeModelLowerer.lowerShapeModules> {
  applies_to fn ShapeModelLowerer.lowerShapeModules
  status Explained
  confidence High
  summary "Change declarations must be applied before derived facts are emitted."
  owner ShapeMaintainers
  protects shape EffectiveModelOrder
  guards on_change require ReEvaluation<Self>
}
