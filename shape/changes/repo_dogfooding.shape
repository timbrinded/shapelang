reevaluation BindingDocsCouplingRechecked {
  satisfies memory BindingDocsCouplingContract
  outcome Confirmed
  summary "Binding checks now enforce docs coupling from changed-file input and only accept docs_not_needed attestations changed in the current run."
  reviewer ShapeMaintainers
  decided_on "2026-05-19"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation CheckPipelineOrderRechecked {
  satisfies memory CheckPipelineOrder
  outcome Confirmed
  summary "The checker still lowers modules before name, context, rule, coverage, and binding checks run."
  reviewer ShapeMaintainers
  decided_on "2026-05-19"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation FormatterBindingFormatRechecked {
  satisfies memory FormatterCanonicalDiffs
  outcome Confirmed
  summary "Binding declarations are formatted in deterministic member order with stable nested path indentation."
  reviewer ShapeMaintainers
  decided_on "2026-05-19"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

