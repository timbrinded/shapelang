module changes.absolute_changed_paths

import shape.checker

import shape.delivery

reevaluation BindingDocsCouplingAbsolutePaths {
  satisfies memory BindingDocsCouplingContract
  outcome Confirmed
  summary "Binding attestation currentness now compares absolute Shape provenance paths against repo-relative changed-file input."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

reevaluation CoverageCurrentDeltaAbsolutePaths {
  satisfies memory CoverageCurrentDeltaContract
  outcome Confirmed
  summary "Coverage currentness now compares absolute Shape provenance paths against repo-relative changed-file input."
  reviewer ShapeMaintainers
  decided_on "2026-05-20"
  evidence test("packages/shp-checker/src/checker.test.ts")
}

attest docs_not_needed {
  source ts("packages/shp-checker/src/checker.ts")
  reason "Path normalization bug fix preserves documented current-change semantics; no diagnostics or user workflow docs changed."
}

change NormalizeCurrentChangedFileMatching {
  modify fn CiPipeline.runShapeContractReview
    source yaml(".github/workflows/shape.yml")
    effects complete {
      Read<ChangedFileList>
        evidence yaml(".github/workflows/shape.yml")
      Read<CiWorkflow>
        evidence yaml(".github/workflows/shape.yml")
      Read<CopilotReviewPrompt>
        evidence md(".github/prompts/shape-contract-review.md")
      Read<SemanticDiagnostics>
        evidence yaml(".github/workflows/shape.yml")
      Update<CopilotReviewResult>
        evidence mjs(".github/scripts/check-copilot-shape-review.mjs")
    }
  modify fn ShapeBindings.checkBindings : RefactorSensitive
    source ts("packages/shp-checker/src/checker.ts#checkBindings")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ShapeBinding>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
  modify fn ShapeRuleEngine.checkCoverage : RefactorSensitive
    source ts("packages/shp-checker/src/checker.ts#checkCoverage")
    effects complete {
      Append<SemanticDiagnostics>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<ChangedFileList>
        evidence ts("packages/shp-checker/src/checker.ts")
      Read<EffectiveModel>
        evidence ts("packages/shp-checker/src/checker.ts")
    }
  modify implementation WorkflowSource {
    paths {
      ".github/scripts/**/*.mjs"
      ".github/workflows/**/*.yml"
    }
    conforms_to CiPipeline
    on_change require shape_delta
  }
}
