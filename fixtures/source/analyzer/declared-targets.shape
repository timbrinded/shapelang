module analyzer.declared_targets

resource AuditEvent {
  storage postgres.table("audit_events")
}

resource AuditEventArchive {
  storage postgres.table("audit_event_archive")
}

resource AuditEventStaging {
  storage postgres.table("audit_event_staging")
}

component AuditMaintenance {
  owns AuditEvent
  owns AuditEventArchive
  owns AuditEventStaging
  grants DropStorage<AuditEventArchive>
  grants HardDelete<AuditEvent>
  grants Truncate<AuditEventStaging>
  fn purge
    source sql("fixtures/source/analyzer/sql/destructive.sql")
    effects complete {
      DropStorage<AuditEventArchive>
        evidence sql("fixtures/source/analyzer/sql/destructive.sql:8-10")
      HardDelete<AuditEvent>
        evidence sql("fixtures/source/analyzer/sql/destructive.sql:1-4")
      Truncate<AuditEventStaging>
        evidence sql("fixtures/source/analyzer/sql/destructive.sql:5-7")
    }
}
