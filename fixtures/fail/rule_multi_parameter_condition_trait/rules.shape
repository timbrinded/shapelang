module rules

trait PairScoped<Left: Resource, Right: Resource> {
}

resource AuditEvent : PairScoped

component AuditStore {
  owns AuditEvent
  grants HardDelete<AuditEvent>
  fn purgeEvents
    effects complete {
      HardDelete<AuditEvent>
    }
}

rule multi_parameter_condition_trait {
  forbid final HardDelete<T>
  when T has PairScoped
}
