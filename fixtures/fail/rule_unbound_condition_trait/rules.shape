module rules

trait Unbound<T> {
}

resource AuditEvent : Unbound

component AuditStore {
  owns AuditEvent
  grants HardDelete<AuditEvent>
  fn purgeEvents
    effects complete {
      HardDelete<AuditEvent>
    }
}

rule unbound_condition_trait {
  forbid final HardDelete<T>
  when T has Unbound
}
