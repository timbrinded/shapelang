module rules

trait FunctionScoped<T: Fn> {
}

resource AuditEvent : FunctionScoped

component AuditStore {
  owns AuditEvent
  grants HardDelete<AuditEvent>
  fn purgeEvents
    effects complete {
      HardDelete<AuditEvent>
    }
}

rule function_condition_trait {
  forbid final HardDelete<T>
  when T has FunctionScoped
}
