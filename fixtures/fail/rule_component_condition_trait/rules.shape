module rules

trait ComponentScoped<T: Component> {
}

resource AuditEvent : ComponentScoped

component AuditStore {
  owns AuditEvent
  grants HardDelete<AuditEvent>
  fn purgeEvents
    effects complete {
      HardDelete<AuditEvent>
    }
}

rule component_condition_trait {
  forbid final HardDelete<T>
  when T has ComponentScoped
}
