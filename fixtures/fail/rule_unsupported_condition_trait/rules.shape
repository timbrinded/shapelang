module rules

trait ServiceScoped<T: Service> {
}

resource AuditEvent : ServiceScoped

component AuditStore {
  owns AuditEvent
  grants HardDelete<AuditEvent>
  fn purgeEvents
    effects complete {
      HardDelete<AuditEvent>
    }
}

rule unsupported_condition_trait {
  forbid final HardDelete<T>
  when T has ServiceScoped
}
