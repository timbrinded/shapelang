module gateway

resource PolicySnapshot

component Gateway {
  owns PolicySnapshot
  grants Read<PolicySnapshot>
  fn pollAttestation : SharpEdge
    effects complete {
      Read<PolicySnapshot>
    }
}

memory BridgeRetryDelaySharpEdge : HardFoughtKnowledge<fn Gateway.pollAttestation> {
  applies_to fn Gateway.pollAttestation
  status Unexplained
  confidence High
  summary "Previous attempts to lower this delay caused intermittent settlement failures."
  owner BridgeTeam
}
