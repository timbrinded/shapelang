module feed

resource PrivateDraft

component Feed {
}

component Recommender {
}

relation FeedCallsRecommender {
  kind calls
  connects Feed -> Recommender
}

relation RecommenderProvidesDrafts {
  kind provides
  connects Recommender -> PrivateDraft
}

rule no_feed_to_drafts {
  forbid path Feed -> PrivateDraft over provides
}
