module feed

resource PrivateDraft

component PublicFeed {
}

component Recommender {
}

relation PublicFeedCallsRecommender {
  kind calls
  connects PublicFeed -> Recommender
}

relation RecommenderProvidesDrafts {
  kind provides
  connects Recommender -> PrivateDraft
}

rule no_feed_to_drafts {
  forbid path PublicFeed -> PrivateDraft over provides
}
