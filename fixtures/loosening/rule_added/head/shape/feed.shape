module feed

resource PrivateDraft

component Feed {
}

component Recommender {
}

relation RecommenderProvidesDrafts {
  kind provides
  connects Recommender -> PrivateDraft
}

rule no_feed_to_drafts {
  forbid path Feed -> PrivateDraft over calls or provides
}

rule no_recommender_to_feed {
  forbid path Recommender -> Feed over calls
}
