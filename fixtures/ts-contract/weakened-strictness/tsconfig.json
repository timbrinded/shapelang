{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "noEmit": true,
    "types": []
  },
  "contentMappers": [
    {
      "package": "@shape/shp-ts-contract",
      "extensions": [
        ".shape"
      ],
      "options": {
        "repoRoot": "."
      }
    }
  ],
  "include": [
    "src/**/*"
  ]
}
