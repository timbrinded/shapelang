---
import DraftContentNotice from "@astrojs/starlight/components/DraftContentNotice.astro";
import { LinkButton } from "@astrojs/starlight/components";

const PAGE_TITLE_ID = "_top";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="shape-hero" aria-labelledby={PAGE_TITLE_ID}>
  <div class="shape-hero__copy">
    <p class="shape-hero__kicker">Architecture rules as text</p>
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {data.draft && <DraftContentNotice />}
    {tagline && <p class="shape-hero__tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="shape-hero__actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  @layer starlight.core {
    .shape-hero {
      position: relative;
      display: grid;
      align-items: center;
      min-height: clamp(28rem, calc(68svh - var(--sl-nav-height)), 38rem);
      width: 100vw;
      margin-block: -1.5rem 3rem;
      margin-inline: calc(50% - 50vw);
      overflow: hidden;
      background: var(--sl-color-bg);
      isolation: isolate;
    }

    .shape-hero__copy {
      position: relative;
      z-index: 1;
      width: min(100% - 2rem, 68rem);
      margin-inline: auto;
      padding: clamp(4.5rem, 10vw, 7.5rem) 1rem clamp(4rem, 8vw, 6.5rem);
    }

    .shape-hero__kicker {
      margin: 0 0 1.15rem;
      color: color-mix(in srgb, var(--shape-agent), white 30%);
      font-family: var(--sl-font-mono);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .shape-hero h1 {
      max-width: 8ch;
      margin: 0;
      color: var(--shape-ink);
      font-size: clamp(4.25rem, 14vw, 9.5rem);
      font-weight: 700;
      letter-spacing: 0;
      line-height: 0.83;
    }

    .shape-hero__tagline {
      max-width: 34rem;
      margin: clamp(1.25rem, 3vw, 1.8rem) 0 0;
      color: var(--shape-slate);
      font-size: clamp(1.1rem, 2.4vw, 1.55rem);
      font-weight: 500;
      line-height: 1.28;
    }

    .shape-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem 1rem;
      margin-top: clamp(1.7rem, 4vw, 2.35rem);
    }

    @media (max-width: 42rem) {
      .shape-hero__copy {
        padding-bottom: clamp(3.5rem, 12vw, 5rem);
      }

      .shape-hero h1 {
        font-size: clamp(4.75rem, 25vw, 7rem);
      }
    }
  }
</style>

<style is:global>
  html[data-has-hero],
  html[data-has-hero] body {
    overflow-x: clip;
  }

</style>
