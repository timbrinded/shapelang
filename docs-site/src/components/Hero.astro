---
import { Image } from "astro:assets";
import DraftContentNotice from "@astrojs/starlight/components/DraftContentNotice.astro";
import { LinkButton } from "@astrojs/starlight/components";

const PAGE_TITLE_ID = "_top";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
  loading: "eager" as const,
  decoding: "async" as const,
  alt: image?.alt || ""
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
  if ("file" in image) {
    darkImage = image.file;
  } else if ("dark" in image) {
    darkImage = image.dark;
    lightImage = image.light;
  } else {
    rawHtml = image.html;
  }
}
---

<section class="shape-hero" aria-labelledby={PAGE_TITLE_ID}>
  <div class="shape-hero__media">
    {
      darkImage && (
        <Image
          src={darkImage}
          {...imageAttrs}
          class:list={["shape-hero__image", { "light:sl-hidden": Boolean(lightImage) }]}
        />
      )
    }
    {lightImage && <Image src={lightImage} {...imageAttrs} class="shape-hero__image dark:sl-hidden" />}
    {rawHtml && <div class="shape-hero__html" set:html={rawHtml} />}
  </div>
  <div class="shape-hero__shade" aria-hidden="true" />
  <div class="shape-hero__copy">
    <p class="shape-hero__kicker">Typed system memory</p>
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {data.draft && <DraftContentNotice />}
    {tagline && <p class="shape-hero__tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="shape-hero__actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  @layer starlight.core {
    .shape-hero {
      position: relative;
      display: grid;
      align-items: end;
      min-height: clamp(34rem, calc(100svh - var(--sl-nav-height)), 47rem);
      width: 100vw;
      margin-block: -1.5rem 3rem;
      margin-inline: calc(50% - 50vw);
      overflow: hidden;
      background: #050c13;
      isolation: isolate;
    }

    .shape-hero__media,
    .shape-hero__shade,
    .shape-hero__image,
    .shape-hero__html {
      position: absolute;
      inset: 0;
    }

    .shape-hero__image {
      z-index: -3;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(1.04) contrast(1.02);
      transform: scale(1.01);
    }

    .shape-hero__html {
      z-index: -3;
    }

    .shape-hero__media,
    .shape-hero__shade {
      pointer-events: none;
    }

    .shape-hero__shade {
      z-index: -2;
      background:
        radial-gradient(circle at 74% 36%, transparent 0 18rem, rgba(5, 12, 19, 0.12) 28rem, rgba(5, 12, 19, 0.46) 48rem),
        linear-gradient(90deg, rgba(5, 12, 19, 0.95) 0%, rgba(5, 12, 19, 0.78) 30%, rgba(5, 12, 19, 0.24) 61%, rgba(5, 12, 19, 0.42) 100%),
        linear-gradient(0deg, rgba(5, 12, 19, 0.94) 0%, rgba(5, 12, 19, 0.18) 42%, rgba(5, 12, 19, 0.36) 100%);
    }

    .shape-hero::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      z-index: -1;
      height: 10rem;
      background: linear-gradient(180deg, transparent, var(--sl-color-bg));
    }

    .shape-hero__copy {
      position: relative;
      z-index: 1;
      width: min(100% - 2rem, 68rem);
      margin-inline: auto;
      padding: clamp(4.5rem, 10vw, 7.5rem) 1rem clamp(4rem, 8vw, 6.5rem);
    }

    .shape-hero__kicker {
      margin: 0 0 1.15rem;
      color: color-mix(in srgb, var(--shape-agent), white 30%);
      font-family: var(--sl-font-mono);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .shape-hero h1 {
      max-width: 8ch;
      margin: 0;
      color: #ffffff;
      font-size: clamp(4.25rem, 14vw, 9.5rem);
      font-weight: 700;
      letter-spacing: 0;
      line-height: 0.83;
    }

    .shape-hero__tagline {
      max-width: 34rem;
      margin: clamp(1.25rem, 3vw, 1.8rem) 0 0;
      color: color-mix(in srgb, white, var(--shape-slate) 16%);
      font-size: clamp(1.1rem, 2.4vw, 1.55rem);
      font-weight: 500;
      line-height: 1.28;
    }

    .shape-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem 1rem;
      margin-top: clamp(1.7rem, 4vw, 2.35rem);
    }

    @media (max-width: 42rem) {
      .shape-hero {
        min-height: calc(100svh - var(--sl-nav-height));
      }

      .shape-hero__image {
        object-position: 61% center;
      }

      .shape-hero__shade {
        background:
          linear-gradient(180deg, rgba(5, 12, 19, 0.66) 0%, rgba(5, 12, 19, 0.42) 36%, rgba(5, 12, 19, 0.94) 78%),
          linear-gradient(90deg, rgba(5, 12, 19, 0.74), rgba(5, 12, 19, 0.18));
      }

      .shape-hero__copy {
        padding-bottom: clamp(3.5rem, 12vw, 5rem);
      }

      .shape-hero h1 {
        font-size: clamp(4.75rem, 25vw, 7rem);
      }
    }
  }
</style>

<style is:global>
  html[data-has-hero],
  html[data-has-hero] body {
    overflow-x: clip;
  }

  .shape-hero .sl-link-button.primary {
    color: #ffffff;
    background: linear-gradient(180deg, #0aa3e6, #00639a);
    border-color: transparent;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.16) inset,
      0 14px 34px rgba(0, 99, 154, 0.34);
  }

  .shape-hero .sl-link-button.primary:hover {
    color: #ffffff;
    background: linear-gradient(180deg, #18b3f4, #0077b8);
  }

  .shape-hero .sl-link-button.secondary {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.78);
  }
</style>
