{
  "name": "shapelang",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs-site"
  ],
  "scripts": {
    "build:release": "scripts/build-release-assets.sh",
    "docs:build": "bun run --cwd docs-site build",
    "docs:check": "bun run --cwd docs-site check",
    "docs:dev": "bun run --cwd docs-site dev",
    "docs:preview": "bun run --cwd docs-site preview",
    "langium:generate": "bunx langium-cli generate",
    "shp": "bun packages/shp-cli/src/index.ts",
    "test": "bun test",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "beta",
    "langium-cli": "^4.2.1"
  }
}
