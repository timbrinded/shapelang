{
  "name": "shapelang",
  "private": true,
  "license": "BSD-3-Clause",
  "workspaces": {
    "packages": [
      "packages/*",
      "docs-site"
    ],
    "catalog": {
      "@astrojs/starlight": "^0.42.8",
      "@astrojs/ts-content-mapper": "^0.2.0",
      "@fontsource-variable/geist": "^5.2.8",
      "@fontsource-variable/geist-mono": "^5.2.8",
      "@kreuzberg/tree-sitter-language-pack": "1.9.0",
      "@stricli/core": "^1.2.7",
      "@types/bun": "latest",
      "@typescript/native-preview": "beta",
      "astro": "^7.4.4",
      "astro-expressive-code": "^0.44.0",
      "jsonc-parser": "3.3.1",
      "langium": "^4.2.4",
      "langium-cli": "^4.2.1",
      "oxfmt": "^0.51.0",
      "oxlint": "^1.66.0",
      "typescript": "7.1.0-beta",
      "vscode-languageserver": "~9.0.1",
      "vscode-languageserver-textdocument": "~1.0.12"
    }
  },
  "type": "module",
  "scripts": {
    "ast:check": "bun scripts/generate-ast-shapes.ts --check",
    "ast:generate": "bun scripts/generate-ast-shapes.ts",
    "build:release": "scripts/build-release-assets.sh",
    "changed-files": "scripts/write-changed-files.sh changed.txt changed-base.txt",
    "docs:build": "bun run --cwd docs-site build",
    "docs:check": "bun run --cwd docs-site check",
    "docs:dev": "bun run --cwd docs-site dev",
    "docs:preview": "bun run --cwd docs-site preview",
    "format": "oxfmt --write . && bun run format:shape",
    "format:check": "oxfmt --check . && bun run format:shape:check",
    "format:shape": "find . -name '*.shape' -not -path './node_modules/*' -not -path './.research/*' -print0 | xargs -0 bun shp fmt",
    "format:shape:check": "find . -name '*.shape' -not -path './node_modules/*' -not -path './.research/*' -print0 | xargs -0 bun shp fmt --check",
    "kernel:bench": "bun experiments/semantic-kernel/harness/benchmark.ts",
    "kernel:build": "cd experiments/semantic-kernel && cargo build --locked --release && scripts/build-wasm.sh",
    "kernel:check": "cd experiments/semantic-kernel && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked",
    "kernel:e2e": "bun experiments/semantic-kernel/harness/e2e.ts",
    "langium:generate": "bunx langium-cli generate",
    "lint": "oxlint --deny-warnings .",
    "release:metadata": "bun scripts/check-release-metadata.ts",
    "skills:check": "bun scripts/check-skills.ts",
    "shape:check": "bun shp check",
    "shape:ci": "bun run ast:check && bun run format:shape:check && bun shp check --changed-files changed.txt --base-ref \"$(cat changed-base.txt)\" --check-cited-paths && bun shp obligations && bun shp memory",
    "shape:loosening": "bun shp check --changed-files changed.txt --base-ref \"$(cat changed-base.txt)\" --check-loosening",
    "shape:coverage": "bun shp coverage --changed-files changed.txt --base-ref \"$(cat changed-base.txt)\"",
    "shp": "bun packages/shp-cli/src/index.ts",
    "test": "bun test",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@shape/shp-ts-contract": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "langium-cli": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "jsonschema": "1.4.1"
  },
  "packageManager": "bun@1.4.2"
}
